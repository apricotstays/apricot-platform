---
import "@fontsource-variable/fraunces/standard.css";
import "@fontsource-variable/fraunces/standard-italic.css";
import "@fontsource-variable/dm-sans/wght.css";
import "@apricot/brand/tokens.css";
// Preload the Latin font files used above the fold to avoid a layout shift on font swap.
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url";
import frauncesItalicUrl from "@fontsource-variable/fraunces/files/fraunces-latin-standard-italic.woff2?url";
import dmSansUrl from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  og?: { title: string; description: string };
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, og, jsonLd } = Astro.props;
// build.format "file": pathnames look like "/index.html" or "/privacy.html".
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "$1") || "/";
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F6EEE3" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {og && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Apricot Stays" />
        <meta property="og:locale" content="en_IN" />
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Apricot Stays — Stay like you live here." />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {[frauncesUrl, frauncesItalicUrl, dmSansUrl].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html,
  body {
    background: var(--bg);
    color: var(--ink);
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--apricot-text);
    outline-offset: 3px;
  }
</style>

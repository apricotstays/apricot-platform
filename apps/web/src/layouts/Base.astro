---
import "@apricot/brand/tokens.css";
import { fonts } from "@apricot/brand";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  og?: { title: string; description: string };
  jsonLd?: Record<string, unknown>;
  /** Override the Google Fonts stylesheet (defaults to the brand set). */
  fontsHref?: string;
}

const {
  title,
  description,
  noindex = false,
  og,
  jsonLd,
  fontsHref = fonts.googleFontsHref,
} = Astro.props;
// With build.format "file", pathnames look like "/index.html" or "/about.html".
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "$1") || "/";
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F6EEE3" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {og && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Apricot Stays" />
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html,
  body {
    background: var(--bg);
    color: var(--ink);
  }
  a {
    color: inherit;
  }
</style>

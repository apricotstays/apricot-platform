---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found · Apricot Stays" description="This page doesn't exist." noindex>
  <Navbar sticky={false} />
  <main id="main" class="grid min-h-[60vh] place-content-center px-6 py-24 text-center">
    <div class="mx-auto mb-5 h-px w-10 bg-apricot" aria-hidden="true"></div>
    <h1 class="mb-4 font-serif text-4xl font-normal text-stone-900 sm:text-5xl">
      This page has moved out.
    </h1>
    <p class="mx-auto mb-8 max-w-md text-lg text-stone-600">
      It may have been an old link. Our homes are all on the home page.
    </p>
    <a href="/" class="btn-secondary mx-auto min-h-12">
      Back to Apricot Stays
    </a>
  </main>
  <Footer />
</Base>

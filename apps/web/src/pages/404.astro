---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found · Apricot Stays" description="This page doesn't exist." noindex>
  <Header />
  <main>
    <h1>
      This page has <em>moved out</em>.
    </h1>
    <p>It may have been an old link. The home page has everything for now.</p>
    <a class="btn" href="/">
      Back to Apricot Stays
    </a>
  </main>
  <Footer />
</Base>

<style is:global>
  body {
    font-family: var(--font-body);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    display: grid;
    place-content: center;
    text-align: center;
    padding: 24px 16px 64px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 7vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  h1 em {
    color: var(--apricot-deep);
  }
  main p {
    color: var(--ink-2);
    font-size: 18px;
    max-width: 36ch;
    margin: 0 auto 30px;
  }
  .btn {
    justify-self: center;
    display: inline-block;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }
</style>

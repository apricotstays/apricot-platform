---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---

<Base
  title="Thank you · Apricot Stays"
  noindex
  fontsHref="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;1,9..144,400&family=DM+Sans:wght@400;600&display=swap"
>
  <main>
    <Logo />
    <h1>
      You're on the <em>list</em>.
    </h1>
    <p>We'll write when the new site opens. You'll hear from us before anyone else.</p>
    <a href="/">Back to Apricot Stays</a>
  </main>
</Base>

<style is:global>
  body {
    font-family: var(--font-body);
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px 16px;
    text-align: center;
    line-height: 1.6;
  }
  svg {
    width: 56px;
    height: 56px;
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 7vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  h1 em {
    color: var(--apricot-deep);
  }
  p {
    color: var(--ink-2);
    font-size: 18px;
    max-width: 36ch;
    margin: 0 auto 30px;
  }
  a {
    display: inline-block;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
  }
</style>

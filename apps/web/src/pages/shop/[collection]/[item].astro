---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import OrderButton from "../../../components/shop/OrderButton.astro";
import Shelf from "../../../components/shop/Shelf.astro";
import ShopInfo from "../../../components/shop/ShopInfo.astro";
import { contact } from "@apricot/brand";
import {
  collections,
  displayTitle,
  formatPrice,
  fromPrice,
  orderMessage,
  type ShopCollection,
  type ShopItem,
} from "../../../data/shop";

/* /shop/<collection>/<item> — one product. Data: src/data/shop.ts. */
export const getStaticPaths = (() =>
  collections.flatMap((c) =>
    c.items.map((item) => ({
      params: { collection: c.slug, item: item.slug },
      props: { c, item },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  c: ShopCollection;
  item: ShopItem;
}
const { c, item } = Astro.props;
const title = displayTitle(c, item);
const unit = c.unit.charAt(0).toUpperCase() + c.unit.slice(1);
const more = c.items.filter((i) => i.slug !== item.slug);
const pair = collections.find((o) => o.slug !== c.slug);
const crumb = "text-[#6b5f52] underline-offset-4 hover:text-[#2f4a3a] hover:underline";
---

<Base
  title={`${item.title} · ${c.title} · Apricot Stays`}
  description={`${item.description} ${unit}, ${formatPrice(c.price)}. Order on WhatsApp.`}
  noindex
  og={{ image: item.image, imageAlt: item.alt }}
>
  <Navbar />

  <main id="main" class="bg-[#fbf7f0] text-[#3b3631]">
    <div class="container mx-auto px-6 pt-6">
      <nav aria-label="Breadcrumb" class="text-sm text-[#6b5f52]">
        <a href="/shop" class={crumb}>
          The Garden Shop
        </a>
        <span aria-hidden="true"> › </span>
        <a href={`/shop/${c.slug}`} class={crumb}>
          {c.title}
        </a>
        <span aria-hidden="true"> › </span>
        <span aria-current="page">{c.quoted ? `No. ${item.no}` : item.title}</span>
      </nav>
    </div>

    <section class="container mx-auto flex flex-wrap items-start gap-10 px-6 pt-6 pb-10">
      <div class="max-w-[620px] min-w-0 flex-[1_1_420px]">
        <div
          class="overflow-hidden rounded-[18px] bg-[#d6dee4]"
          style={`aspect-ratio: ${c.aspect}`}
        >
          <Image
            src={item.image}
            alt={item.alt}
            widths={[400, 620, 900]}
            sizes="(min-width: 1024px) 620px, 100vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="mt-2.5 text-[13px] text-[#6b5f52]">
          Design preview. Colours in print may vary slightly.
        </p>
      </div>

      <div class="flex max-w-[520px] min-w-0 flex-[1_1_360px] flex-col gap-5">
        <div>
          <p class="mb-2 text-xs font-semibold tracking-[0.16em] text-[#8a5a3c] uppercase">
            {c.title} · No. {item.no}
          </p>
          <h1 class="font-serif text-4xl leading-[1.15] font-medium text-[#2f4a3a] sm:text-[42px]">
            {title}
          </h1>
          <p class="mt-2 text-base text-[#6b5f52]">
            {unit}
            {item.note && ` · ${item.note}`}
          </p>
        </div>
        <p class="font-serif text-3xl text-[#2f4a3a]">{formatPrice(c.price)}</p>
        <p class="text-[17px] leading-relaxed">{item.description}</p>
        <div class="flex flex-col gap-2.5">
          <OrderButton href={contact.whatsappLink(orderMessage(c, item))} size="lg" />
          <p class="text-center text-sm text-[#6b5f52]">
            Pay by UPI after we confirm. Sending it as a gift? Just say so in the chat.
          </p>
        </div>
        <dl class="grid grid-cols-[110px_minmax(0,1fr)] border-t border-[#e6d5bf] text-[15px] leading-normal">
          {c.details.map((d) => (
            <>
              <dt class="border-b border-[#e6d5bf] py-3 font-semibold">{d.label}</dt>
              <dd class="border-b border-[#e6d5bf] py-3">{d.value}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <Shelf
      collection={c}
      items={more.slice(0, 6)}
      heading={`More from ${c.title}`}
      id="more"
      full={false}
    />

    {pair && (
      <section class="container mx-auto px-6 pt-4 pb-12">
        <a
          href={`/shop/${pair.slug}`}
          class="flex flex-wrap items-center gap-5 rounded bg-[#f4ece0] p-[18px] text-[#2f4a3a] hover:bg-[#efe4d4] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          <Image
            src={pair.items[0].image}
            alt=""
            widths={[144]}
            sizes="72px"
            class="h-24 w-[72px] rounded-[10px] object-cover"
          />
          <span class="min-w-0 flex-[1_1_240px]">
            <span class="block text-xs font-semibold tracking-[0.16em] text-[#8a5a3c] uppercase">
              Pairs well with
            </span>
            <span class="mt-1 block font-serif text-xl">
              {pair.title} · {pair.kind.toLowerCase()} {fromPrice(pair)}
            </span>
          </span>
          <span class="font-semibold">
            See {pair.kind.toLowerCase()}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </section>
    )}

    <ShopInfo />
  </main>

  <Footer />
</Base>

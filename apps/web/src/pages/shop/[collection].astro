---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import OrderButton from "../../components/shop/OrderButton.astro";
import ShopInfo from "../../components/shop/ShopInfo.astro";
import { contact } from "@apricot/brand";
import {
  collections,
  displayTitle,
  formatPrice,
  fromPrice,
  orderMessage,
  productHref,
  type ShopCollection,
} from "../../data/shop";

/* /shop/<collection> — the full grid for one collection. Data: src/data/shop.ts. */
export const getStaticPaths = (() =>
  collections.map((c) => ({
    params: { collection: c.slug },
    props: { c },
  }))) satisfies GetStaticPaths;

interface Props {
  c: ShopCollection;
}
const { c } = Astro.props;
const others = collections.filter((o) => o.slug !== c.slug);
const crumb = "text-[#6b5f52] underline-offset-4 hover:text-[#2f4a3a] hover:underline";
---

<Base
  title={`${c.title} · The Garden Shop · Apricot Stays`}
  description={`${c.intro} From ${formatPrice(c.price)} each. Order on WhatsApp.`}
  noindex
>
  <Navbar />

  <main id="main" class="bg-[#fbf7f0] text-[#3b3631]">
    <section class="container mx-auto px-6 pt-6">
      <nav aria-label="Breadcrumb" class="text-sm text-[#6b5f52]">
        <a href="/shop" class={crumb}>
          The Garden Shop
        </a>
        <span aria-hidden="true"> › </span>
        <span aria-current="page">{c.title}</span>
      </nav>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl min-w-0 flex-[1_1_520px]">
          <p class="mb-2.5 text-xs font-semibold tracking-[0.16em] text-[#8a5a3c] uppercase">
            {c.kind}
            {c.badge && ` · ${c.badge}`}
          </p>
          <h1 class="font-serif text-5xl leading-[1.1] font-medium text-[#2f4a3a]">{c.title}</h1>
          <p class="mt-3.5 text-[17px] leading-relaxed">{c.intro}</p>
        </div>
        <div class="flex-[0_1_340px] rounded border border-[#e6d5bf] bg-white px-[22px] py-[18px]">
          <p class="font-serif text-2xl text-[#2f4a3a]">{formatPrice(c.price)} each</p>
          <p class="mt-1 text-[15px] leading-relaxed">{c.specs}.</p>
        </div>
      </div>
    </section>

    <section aria-label={c.title} class="container mx-auto px-6 pt-8 pb-6">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {c.items.map((item, i) => (
          <li class="flex flex-col overflow-hidden rounded border border-[#e6d5bf] bg-white">
            <a
              href={productHref(c, item)}
              class="relative block bg-[#d6dee4] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:outline-none focus-visible:ring-inset"
              style={`aspect-ratio: ${c.aspect}`}
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={item.image}
                alt=""
                widths={[360, 540, 720]}
                sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading={i < 4 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
              <span class="absolute top-3 left-3 rounded bg-white/90 px-2.5 py-1 text-xs font-semibold text-[#3b3631]">
                No. {item.no}
              </span>
            </a>
            <div class="flex flex-1 flex-col gap-3 p-4">
              <div class="flex-1">
                <a
                  href={productHref(c, item)}
                  class="font-serif text-lg leading-snug text-[#2f4a3a] hover:underline focus-visible:underline"
                >
                  {displayTitle(c, item)}
                </a>
                {item.note && <p class="mt-0.5 text-[13px] text-[#6b5f52]">{item.note}</p>}
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-semibold">{formatPrice(c.price)}</span>
                <OrderButton
                  href={contact.whatsappLink(orderMessage(c, item))}
                  label="Order"
                  ariaLabel={`Order ${item.title} on WhatsApp`}
                />
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-[#6b5f52]">{c.footnote}</p>
    </section>

    {others.map((o) => (
      <section class="container mx-auto px-6 pt-2 pb-12">
        <a
          href={`/shop/${o.slug}`}
          class="flex flex-wrap items-center justify-between gap-3 rounded bg-[#f4ece0] px-6 py-5 text-[#2f4a3a] hover:bg-[#efe4d4] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          <span>
            <span class="block text-xs font-semibold tracking-[0.16em] text-[#8a5a3c] uppercase">
              Also in the shop
            </span>
            <span class="font-serif text-2xl">
              {o.title} · {o.kind.toLowerCase()} {fromPrice(o)}
            </span>
          </span>
          <span class="font-semibold">
            See {o.kind.toLowerCase()}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      </section>
    ))}

    <ShopInfo />
  </main>

  <Footer />
</Base>

---
import type { GetStaticPaths } from "astro";
import { Picture, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import TrustLine from "../../components/TrustLine.astro";
import AvailabilityCalendar from "../../components/AvailabilityCalendar.astro";
import GuestReviews from "../../components/GuestReviews.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import { fromLine, properties, ratesChecked, to24h, type Property } from "@apricot/schema";
import { brand, contact, promise } from "@apricot/brand";
import { galleries, rooms } from "../../data/media";
import { reviews } from "../../data/reviews";
import { allAmenities, amenityGroups } from "../../data/amenities";

export const getStaticPaths = (() =>
  properties.map((p) => ({
    params: { slug: p.slug },
    props: { property: p },
  }))) satisfies GetStaticPaths;

interface Props {
  property: Property;
}
const { property: p } = Astro.props;
const gallery = galleries[p.slug];
const [cover, ...rest] = gallery;
const thumbs = rest.slice(0, 4);
const namedRooms = rooms[p.slug] ?? [];
// Photo viewer (design audit item 16): large versions for the full-screen viewer, and tiny
// versions shown blurred behind each photo while it loads.
const big = await Promise.all(
  gallery.map(async (g) => ({
    url: (await getImage({ src: g.src, width: 1600, format: "webp" })).src,
    alt: g.alt,
  })),
);
const tiny = await Promise.all(
  gallery.map(async (g) => (await getImage({ src: g.src, width: 24, format: "webp" })).src),
);
const openLabel = (i: number) => `Open photo ${i + 1} of ${gallery.length}: ${gallery[i].alt}`;
const homeReviews = reviews[p.slug];

const book = contact.whatsappLink(
  `Hi Apricot Stays, I'd like to book ${p.name}.\n\nDates:\nGuests:`,
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${contact.address.geo.latitude},${contact.address.geo.longitude}`;

const pol = p.policy;
const directPerks = [
  `Free cancellation ${pol.freeCancellation.toLowerCase()}`,
  "Full stay credit instead of a partial refund",
  "Late checkout until 2 PM when the home is free",
  "Talk to the hosts on WhatsApp, before and during your stay",
];
type KnowCard = { icon: "clock" | "home" | "shield"; title: string; lines: readonly string[] };
const knowCards: KnowCard[] = [
  {
    icon: "clock",
    title: "Check-in & checkout",
    lines: [
      `Check-in from ${pol.checkIn}`,
      "Self check-in until 8 PM; later by arrangement",
      `Checkout by ${pol.checkOut}`,
      "Minimum 2 nights if your stay includes a Friday or Saturday",
      "Late checkout until 2 PM when the home is free (direct bookings)",
    ],
  },
  { icon: "home", title: "House rules", lines: pol.rules },
  { icon: "shield", title: "Cancellation", lines: pol.cancellation },
];

type Fact = { icon: "users" | "bed" | "bath"; label: string };
const facts: Fact[] = [
  { icon: "users", label: `Up to ${p.maxGuests} guests` },
  ...(p.bedrooms
    ? [{ icon: "bed", label: `${p.bedrooms} bedroom${p.bedrooms > 1 ? "s" : ""}` } as Fact]
    : []),
  ...(p.bathrooms
    ? [{ icon: "bath", label: `${p.bathrooms} bathroom${p.bathrooms > 1 ? "s" : ""}` } as Fact]
    : []),
];
// Beds go right after bedrooms.
facts.splice(p.bedrooms ? 2 : 1, 0, { icon: "bed", label: p.beds });
const groups = amenityGroups[p.slug] ?? [];
const everyAmenity = allAmenities(p.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "@id": `${brand.url}/stays/${p.slug}#lodging`,
  name: p.name,
  url: `${brand.url}/stays/${p.slug}`,
  description: p.description,
  brand: { "@id": `${brand.url}/#organization`, name: brand.name },
  telephone: contact.whatsappE164,
  numberOfRooms: p.bedrooms,
  priceRange: fromLine(p),
  checkinTime: to24h(pol.checkIn),
  checkoutTime: to24h(pol.checkOut),
  petsAllowed: pol.pets === "Welcome",
  amenityFeature: (everyAmenity.length ? everyAmenity : p.amenities).map((a) => ({
    "@type": "LocationFeatureSpecification",
    name: a,
    value: true,
  })),
  address: {
    "@type": "PostalAddress",
    addressLocality: contact.address.locality,
    addressRegion: contact.address.region,
    addressCountry: contact.address.country,
  },
  geo: { "@type": "GeoCoordinates", ...contact.address.geo },
  ...(p.airbnbUrl ? { sameAs: [p.airbnbUrl] } : {}),
};
---

<Base
  title={`${p.name} · Apricot Stays, New Chandigarh`}
  description={`${p.summary} ${p.name} at ${p.locality}. Up to ${p.maxGuests} guests. Book on WhatsApp.`}
  og={{ image: cover.src, imageAlt: cover.alt }}
  jsonLd={jsonLd}
>
  <Navbar sticky={false} />

  <main id="main" class="bg-white pt-12">
    <div class="container mx-auto mb-6 px-6">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-stone-500">
        <a href="/#collection" class="hover:text-stone-800">
          Our Collection
        </a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{p.name}</span>
      </nav>
      <p class="mb-2 text-sm tracking-wider text-stone-500 uppercase">{p.locality}</p>
      <h1 class="font-serif text-4xl leading-tight font-normal text-stone-900 md:text-5xl">
        {p.name}
      </h1>
      <a
        href="/#promise"
        class="mt-4 inline-flex items-center gap-2 border border-stone-300 px-4 py-2.5 text-sm text-stone-800 hover:bg-stone-50"
      >
        <Icon name="sprout" size={18} />
        <span>
          <strong class="font-semibold">{promise.name}</strong> · {p.garden.toLowerCase()}
        </span>
      </a>
    </div>

    <!-- Gallery -->
    <div class="container mx-auto mb-12 px-6">
      <div class:list={["grid gap-2 overflow-hidden", thumbs.length > 0 && "md:grid-cols-2"]}>
        <div
          class:list={[
            "relative bg-stone-100",
            thumbs.length > 0 ? "aspect-square md:row-span-2" : "aspect-[16/9]",
          ]}
        >
          <a
            href={big[0].url}
            data-viewer-open="0"
            class="block h-full w-full focus-visible:ring-2 focus-visible:ring-apricot focus-visible:outline-none focus-visible:ring-inset"
            aria-label={openLabel(0)}
          >
            <Picture
              src={cover.src}
              alt={cover.alt}
              widths={[480, 800, 1200]}
              sizes={thumbs.length > 0 ? "(min-width: 768px) 50vw, 100vw" : "100vw"}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          </a>
          {gallery.length > 1 && (
            <span class="pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded bg-stone-950/70 px-2.5 py-1 text-xs font-medium text-white md:hidden">
              1 / {gallery.length} · tap to view
            </span>
          )}
        </div>
        {thumbs.length > 0 && (
          <div class="hidden grid-cols-2 grid-rows-2 gap-2 md:grid">
            {thumbs.map((img, i) => (
              <div class="relative aspect-square bg-stone-100">
                <a
                  href={big[i + 1].url}
                  data-viewer-open={String(i + 1)}
                  class="block h-full w-full focus-visible:ring-2 focus-visible:ring-apricot focus-visible:outline-none focus-visible:ring-inset"
                  aria-label={openLabel(i + 1)}
                >
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={[300, 600]}
                    sizes="25vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover"
                  />
                </a>
                {i === thumbs.length - 1 && gallery.length > 5 && (
                  <a
                    href="#photos"
                    data-viewer-open="0"
                    class="absolute right-4 bottom-4 inline-flex min-h-11 items-center rounded bg-white px-4 text-sm font-medium text-stone-800 shadow-md hover:shadow-lg"
                  >
                    Show all photos
                  </a>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
      {gallery.length === 1 && (
        <p class="mt-3 text-sm text-stone-500">
          More photos coming soon — ask us on WhatsApp for a video tour.
        </p>
      )}
    </div>

    <div class="container mx-auto px-6 pb-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
        <div class="max-w-3xl space-y-12">
          <section id="about" aria-labelledby="about-h">
            <ul class="flex flex-wrap items-center gap-6 border-b border-stone-200 pb-6 text-stone-600">
              {facts.map((f) => (
                <li class="flex items-center gap-2">
                  <Icon name={f.icon} size={20} />
                  <span>{f.label}</span>
                </li>
              ))}
            </ul>
            <h2 id="about-h" class="t-h2 mt-6 mb-4">
              About this stay
            </h2>
            <p class="leading-relaxed text-stone-600">{p.description}</p>
          </section>

          {namedRooms.length > 0 && (
            <section id="rooms" aria-labelledby="rooms-h">
              <h2 id="rooms-h" class="t-h2 mb-2">
                The Five Rivers
              </h2>
              <p class="mb-8 leading-relaxed text-stone-600">
                Five bedrooms, each named for one of the rivers that gave Punjab — Panj-aab, the
                land of five waters — its name.
              </p>
              <div class="space-y-10">
                {namedRooms.map((r) => (
                  <figure>
                    <Picture
                      src={r.photo.src}
                      alt={r.photo.alt}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 1024px) 768px, 100vw"
                      formats={["avif", "webp"]}
                      fallbackFormat="jpg"
                      class="aspect-video w-full bg-stone-100 object-cover"
                    />
                    <figcaption class="mt-3 grid grid-cols-[1fr_auto] items-baseline gap-x-3 gap-y-1 sm:flex">
                      <span class="font-serif text-lg text-stone-800">{r.name}</span>
                      <span class="col-span-2 row-start-2 text-xs tracking-[0.15em] text-stone-500 uppercase">
                        {r.palette}
                      </span>
                      <span class="text-right text-sm text-stone-700">{r.bed}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )}

          {namedRooms.length === 0 && (
            <section id="sleep" aria-labelledby="sleep-h">
              <h2 id="sleep-h" class="t-h2 mb-6">
                Where you'll sleep
              </h2>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="border border-stone-200 p-5">
                  <Icon name="bed" size={24} />
                  <p class="mt-3 font-semibold text-stone-800">Bedroom</p>
                  <p class="text-sm text-stone-600">{p.beds}</p>
                </div>
              </div>
            </section>
          )}

          {homeReviews && <GuestReviews data={homeReviews} airbnbUrl={p.airbnbUrl} />}

          <section id="amenities" aria-labelledby="amenities-h">
            <h2 id="amenities-h" class="t-h2 mb-6">
              Amenities
            </h2>
            <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {p.amenities.map((a) => (
                <li class="flex items-center gap-3 text-stone-600">
                  <span class="h-2 w-2 shrink-0 bg-gold" aria-hidden="true" />
                  {a}
                </li>
              ))}
            </ul>
            {everyAmenity.length > p.amenities.length && (
              <details class="group mt-6">
                <summary class="btn-secondary cursor-pointer list-none px-5 [&::-webkit-details-marker]:hidden">
                  <span class="group-open:hidden">Show all {everyAmenity.length} amenities</span>
                  <span class="hidden group-open:inline">Show fewer</span>
                </summary>
                <div class="mt-6 grid grid-cols-1 gap-x-8 gap-y-6 border border-stone-200 p-6 sm:grid-cols-2 lg:grid-cols-3">
                  {groups.map((g) => (
                    <div>
                      <h3 class="mb-2 text-xs font-semibold tracking-[0.08em] text-stone-800 uppercase">
                        {g.name}
                      </h3>
                      <ul class="space-y-1 text-sm text-stone-600">
                        {g.items.map((i) => (
                          <li>{i}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}
          </section>

          <AvailabilityCalendar slug={p.slug} name={p.name} priceLine={fromLine(p)} />

          <section id="things-to-know" aria-labelledby="know-h">
            <h2 id="know-h" class="t-h2 mb-2">
              Things to know
            </h2>
            <p class="mb-6 text-stone-600">
              The short version. Everything else is on our{" "}
              <a href="/policies" class="font-medium text-stone-800 underline underline-offset-4">
                stay policies &amp; FAQ
              </a>{" "}
              page.
            </p>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
              {knowCards.map((c) => (
                <div class="border border-stone-200 p-5">
                  <h3 class="t-h3 mb-3 flex items-center gap-2">
                    <Icon name={c.icon} size={18} />
                    {c.title}
                  </h3>
                  <ul class="space-y-1.5 text-sm leading-relaxed text-stone-600">
                    {c.lines.map((l) => (
                      <li>{l}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <section id="location" aria-labelledby="location-h">
            <h2 id="location-h" class="t-h2 mb-6">
              Location
            </h2>
            <div class="flex flex-col gap-4 bg-stone-50 p-6 sm:flex-row sm:items-center sm:justify-between">
              <p class="flex items-start gap-3 text-stone-600">
                <Icon name="pin" size={20} class="mt-0.5 shrink-0" />
                <span>
                  {contact.address.locality}, {contact.address.region}. Exact address shared after
                  booking.
                </span>
              </p>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex shrink-0 items-center gap-2 text-sm font-medium text-stone-800 underline underline-offset-4"
              >
                Open in Google Maps <Icon name="external" size={14} />
              </a>
            </div>
          </section>

          {gallery.length > 5 && (
            <section id="photos" aria-labelledby="photos-h" class="scroll-mt-8">
              <h2 id="photos-h" class="t-h2 mb-6">
                All photos
              </h2>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {gallery.map((img, i) => (
                  <a
                    href={big[i].url}
                    data-viewer-open={String(i)}
                    class="relative block aspect-[4/3] overflow-hidden bg-stone-100 focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-2 focus-visible:outline-none"
                    aria-label={openLabel(i)}
                  >
                    <span
                      class="absolute inset-0 scale-110 bg-cover bg-center blur-xl"
                      style={`background-image:url(${tiny[i]})`}
                      aria-hidden="true"
                    ></span>
                    <Picture
                      src={img.src}
                      alt={img.alt}
                      widths={[480, 800]}
                      sizes="(min-width: 640px) 50vw, 100vw"
                      formats={["avif", "webp"]}
                      fallbackFormat="jpg"
                      class="relative h-full w-full object-cover"
                    />
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- Booking card -->
        <aside class="lg:sticky lg:top-8 lg:self-start" aria-label="Book this stay">
          <div class="border border-stone-200 p-6 shadow-sm">
            <p class="mb-1 font-serif text-2xl text-stone-800">Book direct</p>
            <p class="mb-2 text-lg text-stone-800">{fromLine(p)}</p>
            <p class="mb-3 text-sm text-stone-700">
              Every stay comes with{" "}
              <strong class="font-semibold">{promise.name.toLowerCase()}</strong>:{" "}
              {p.garden.toLowerCase()}, never shared.
            </p>
            <p class="mb-4 text-sm text-stone-600">
              Message us with your dates — we'll confirm availability and the exact price.
            </p>
            <!-- Golden hour (design audit item 20): today's sunset for New Chandigarh, computed in
                 the browser; hidden until the script fills it in. -->
            <p
              class="mb-6 flex items-center gap-3 rounded bg-[#fbefe2] px-3 py-2.5 text-sm text-stone-800"
              data-sunset
              hidden
            >
              <svg width="26" height="26" viewBox="0 0 30 30" aria-hidden="true">
                <path d="M3 21h24" stroke="#b5452f" stroke-width="1.6"></path>
                <path d="M8 21a7 7 0 0 1 14 0" fill="#f2b880"></path>
                <g stroke="#c99a5b" stroke-width="1.4" stroke-linecap="round">
                  <path d="M15 8v3M6.5 12l2 2M23.5 12l-2 2"></path>
                </g>
              </svg>
              <span>
                <strong class="font-semibold" data-sunset-time></strong>
                <span class="block text-stone-600">Best watched from your own garden.</span>
              </span>
            </p>
            <!-- Dates line: shown only when this home's availability calendar has loaded. -->
            <button
              type="button"
              class="mb-4 grid w-full grid-cols-2 border border-stone-300 text-left hover:bg-stone-50 aria-expanded:border-stone-800"
              aria-label="Choose dates"
              aria-expanded="false"
              aria-controls="avail-pop"
              data-avail-dates
              hidden
            >
              <span class="flex flex-col gap-0.5 border-r border-stone-300 px-3 py-2.5">
                <span class="text-[11px] font-bold tracking-[0.06em] text-stone-600">CHECK-IN</span>
                <span class="text-sm text-stone-800" data-avail-in>
                  Add date
                </span>
              </span>
              <span class="flex flex-col gap-0.5 px-3 py-2.5">
                <span class="text-[11px] font-bold tracking-[0.06em] text-stone-600">
                  CHECK-OUT
                </span>
                <span class="text-sm text-stone-800" data-avail-out>
                  Add date
                </span>
              </span>
            </button>
            <!-- Calendar inside the card (design audit item 14): same live data and selection as the
                 large calendar further down the page. -->
            <div
              id="avail-pop"
              class="-mt-2 mb-4 border border-t-0 border-stone-300 px-3 pt-3 pb-2"
              data-avail-pop
              hidden
            >
              <div class="mb-1 flex items-center justify-between gap-2">
                <p class="text-sm text-stone-600" data-avail-hint aria-live="polite">
                  Pick your check-in date
                </p>
                <div class="flex gap-1.5">
                  <button
                    type="button"
                    class="avail-nav"
                    aria-label="Previous month"
                    data-avail-prev
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                  </button>
                  <button type="button" class="avail-nav" aria-label="Next month" data-avail-next>
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </button>
                </div>
              </div>
              <div data-avail-months></div>
              <p
                class="mt-2 bg-[#fdf1ea] px-3 py-2 text-xs text-[#8a3b1e]"
                role="status"
                data-avail-note
                hidden
              ></p>
            </div>
            <div class="mb-5 bg-linen p-4">
              <p class="mb-2 text-sm font-semibold text-stone-800">Why book with us directly</p>
              <ul class="space-y-1.5 text-sm leading-snug text-stone-700">
                {directPerks.map((perk) => (
                  <li class="flex gap-2">
                    <Icon name="check" size={16} class="mt-0.5 shrink-0" />
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/policies"
                class="mt-2 inline-block text-xs font-medium text-stone-800 underline underline-offset-4"
              >
                How our policies work
              </a>
            </div>
            <a
              href={book}
              target="_blank"
              rel="noopener"
              class="btn-primary btn-block min-h-12 px-3 py-2"
              data-avail-book
            >
              <Icon name="whatsapp" size={18} />
              <span data-avail-label>Check availability</span>
            </a>
            <div class="mt-4 flex flex-col gap-1 bg-linen px-3.5 py-3" data-avail-msg hidden>
              <span class="text-[11px] font-bold tracking-[0.06em] text-stone-600">
                MESSAGE WE'LL PRE-FILL
              </span>
              <span class="text-sm leading-snug text-stone-800" data-avail-msg-text></span>
            </div>
            {p.airbnbUrl && (
              <p class="mt-3 text-center text-sm text-stone-600">
                Prefer Airbnb?{" "}
                <a
                  href={p.airbnbUrl}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1 text-stone-800 underline underline-offset-4 hover:text-apricot"
                >
                  See this home on Airbnb <Icon name="external" size={13} />
                </a>
              </p>
            )}
            <p class="mt-4 text-center text-xs text-stone-500">
              WhatsApp {contact.whatsappDisplay}
            </p>
            <p class="mt-1 text-center text-xs text-stone-500">
              Starting weekday rate · checked {ratesChecked}
            </p>
            <TrustLine size="xs" class="mt-4 border-t border-stone-100 pt-4" />
          </div>
        </aside>
      </div>
    </div>
  </main>

  <PhotoViewer photos={big} />
  <Footer />
</Base>

<script>
  // Sunset for DLF Hyde Park, New Chandigarh (30.84 N, 76.72 E), NOAA solar equations.
  // Shown in IST whatever the visitor's own time zone is.
  const box = document.querySelector<HTMLElement>("[data-sunset]");
  const out = document.querySelector<HTMLElement>("[data-sunset-time]");
  if (box && out) {
    const lat = 30.8406;
    const lng = 76.7249;
    const now = new Date(Date.now() + 330 * 60000); // IST calendar date
    const y = now.getUTCFullYear();
    const day = Math.floor(
      (Date.UTC(y, now.getUTCMonth(), now.getUTCDate()) - Date.UTC(y, 0, 0)) / 864e5,
    );
    const g = ((2 * Math.PI) / 365) * (day - 1 + (18 - 12) / 24);
    const eqt =
      229.18 *
      (0.000075 +
        0.001868 * Math.cos(g) -
        0.032077 * Math.sin(g) -
        0.014615 * Math.cos(2 * g) -
        0.040849 * Math.sin(2 * g));
    const decl =
      0.006918 -
      0.399912 * Math.cos(g) +
      0.070257 * Math.sin(g) -
      0.006758 * Math.cos(2 * g) +
      0.000907 * Math.sin(2 * g) -
      0.002697 * Math.cos(3 * g) +
      0.00148 * Math.sin(3 * g);
    const rad = Math.PI / 180;
    const ha =
      Math.acos(
        Math.cos(90.833 * rad) / (Math.cos(lat * rad) * Math.cos(decl)) -
          Math.tan(lat * rad) * Math.tan(decl),
      ) / rad;
    const ist = Math.round(720 - 4 * (lng - ha) - eqt + 330); // minutes after midnight IST
    if (Number.isFinite(ist)) {
      const h = Math.floor(ist / 60) % 24;
      const m = ist % 60;
      out.textContent = `Sunset tonight at ${h > 12 ? h - 12 : h}:${String(m).padStart(2, "0")} PM`;
      box.hidden = false;
    }
  }
</script>

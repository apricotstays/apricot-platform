---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { contact } from "@apricot/brand";
import { formatPrice, orderMessage, products, shop } from "../data/shop";

/*
 * /shop — The Garden Shop. Tumblers carrying lines from our garden, printed to order (Qikink)
 * and ordered on WhatsApp: pre-filled message → UPI → printed and shipped.
 * Soft launch: linked from the footer only, noindex, not in the sitemap, until the first
 * printed sample is approved. Palette is page-scoped (Our Story's cream and forest green).
 * Products and price: src/data/shop.ts.
 */
const price = formatPrice(shop.price);
const askHref = contact.whatsappLink("Hi Apricot Stays, a question about the Garden Shop.");
const btn =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[#2f4a3a] px-5 text-sm font-semibold text-white transition-colors hover:bg-[#223729] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-2 focus-visible:outline-none";
const steps = [
  {
    title: "Tap “Order on WhatsApp”",
    text: "A message opens with your design already named. Add how many, and whether it's a gift.",
  },
  {
    title: "Pay by UPI",
    text: "We reply with the total and a payment request. Send us the delivery address.",
  },
  {
    title: "It's printed and shipped",
    text: "Each tumbler is made to order. We share the tracking link in the same chat.",
  },
  {
    title: "Sending it as a gift?",
    text: "Give us their address and a line for the note, and we'll send it straight to them.",
  },
];
---

<Base
  title="The Garden Shop · Apricot Stays"
  description={`Tumblers wrapped in our garden, each carrying one line from it. ${price} each, printed to order and delivered across India. Order on WhatsApp.`}
  noindex
>
  <Navbar />

  <main id="main" class="bg-[#fbf7f0] text-[#3b3631]">
    <section class="container mx-auto flex flex-wrap items-end justify-between gap-10 px-6 pt-14 pb-10 sm:pt-20">
      <div class="max-w-2xl min-w-0 flex-[1_1_520px]">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-[#2f4a3a] uppercase">
          The Garden Shop
        </p>
        <h1 class="font-serif text-5xl leading-[1.08] font-medium text-[#2f4a3a] sm:text-6xl">
          Take the garden home.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed">
          Tumblers wrapped in our garden, each carrying one line from it. Keep one for your own slow
          mornings, or send one to someone who needs a quieter day.
        </p>
      </div>
      <div class="flex-[0_1_340px] rounded-2xl border border-[#e6d5bf] bg-white px-6 py-5">
        <p class="font-serif text-2xl text-[#2f4a3a]">{price} each</p>
        <p class="mt-1 text-[15px] leading-relaxed">
          {shop.specs}. Printed to order and delivered anywhere in India.
        </p>
      </div>
    </section>

    <section aria-labelledby="designs-h" class="container mx-auto px-6 pb-16">
      <h2 id="designs-h" class="sr-only">
        Designs
      </h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {products.map((p, i) => (
          <li class="flex flex-col overflow-hidden rounded-2xl border border-[#e6d5bf] bg-white">
            <div class="relative aspect-[3/4] bg-[#d6dee4]">
              <Image
                src={p.image}
                alt={`Apricot Stays tumbler with ${p.artwork} and the line “${p.quote}”`}
                widths={[360, 540, 720]}
                sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                loading={i < 4 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
              <span class="absolute top-3 left-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold">
                No. {p.no}
              </span>
            </div>
            <div class="flex flex-1 flex-col gap-4 p-5">
              <p class="flex-1 font-serif text-[19px] leading-snug text-[#2f4a3a]">“{p.quote}”</p>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="font-semibold">{price}</span>
                <a
                  href={contact.whatsappLink(orderMessage(p))}
                  target="_blank"
                  rel="noopener"
                  class={btn}
                  aria-label={`Order No. ${p.no} on WhatsApp`}
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" />
                  </svg>
                  Order on WhatsApp
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-[#6b5f52]">
        Product pictures are design previews; colours on the printed tumbler may vary slightly.
      </p>
    </section>

    <section aria-labelledby="how-h" class="bg-[#2f4a3a] text-[#f4ece0]">
      <div class="container mx-auto px-6 py-16">
        <h2 id="how-h" class="font-serif text-4xl font-medium">
          How ordering works
        </h2>
        <ol class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((s, i) => (
            <li class="flex flex-col gap-2">
              <span class="font-serif text-3xl text-[#d8c8b2]">{i + 1}</span>
              <strong class="text-[17px] font-semibold text-white">{s.title}</strong>
              <span class="text-[15px] leading-relaxed">{s.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="container mx-auto flex flex-wrap gap-10 px-6 py-16">
      <div class="min-w-0 flex-[1_1_420px]">
        <h2 class="font-serif text-3xl font-medium text-[#2f4a3a]">Good to know</h2>
        <dl class="mt-5 space-y-5 text-[15px] leading-relaxed">
          <div>
            <dt class="font-semibold">Arrived damaged?</dt>
            <dd class="mt-1">
              Send us a photo on WhatsApp within 48 hours and we'll make it right.
            </dd>
          </div>
          <div>
            <dt class="font-semibold">Staying with us?</dt>
            <dd class="mt-1">
              The tumbler in your home is ours to keep for the next guest. Scan the card beside it
              to order your own.
            </dd>
          </div>
          <div>
            <dt class="font-semibold">Something else?</dt>
            <dd class="mt-1">
              <a
                href={askHref}
                target="_blank"
                rel="noopener"
                class="underline underline-offset-4 hover:text-[#2f4a3a]"
              >
                Ask us on WhatsApp
              </a>
              .
            </dd>
          </div>
        </dl>
      </div>
      <div class="flex min-w-0 flex-[1_1_360px] flex-col justify-center gap-4 rounded-2xl bg-[#f4ece0] p-8">
        <p class="font-serif text-2xl leading-snug text-[#2f4a3a] italic">
          “A garden doesn't ask anything of you. You sit, and the day gets quieter.”
        </p>
        <a
          href="/our-story"
          class="inline-flex min-h-11 items-center text-[15px] font-semibold underline underline-offset-[6px]"
        >
          Read our story
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { trust, contact } from "@apricot/brand";
import { photos, type Photo } from "../data/media";
import shivani from "../assets/team/shivani.jpg";

/*
 * Our Story (/our-story). Copy and design: "Our Story — Shivani & the Garden" doc + design canvas.
 * Page-only palette (handbook): cream ground, forest green headings/band/buttons, terracotta labels.
 * Colours are scoped to this page as arbitrary values; the site theme is unchanged.
 */

const hero = photos.cottageGardenPath;

const idea = [
  {
    title: "Chandigarh was planned around gardens.",
    text: "Le Corbusier drew the city around green space, and the Rose Garden, the Rock Garden and Sukhna Lake are still its heart.",
  },
  { title: "You can visit them. You can't stay in them.", text: "That's the gap." },
  {
    title: "Apricot is a garden you stay in.",
    text: "The thing the city is named for, made personal, without the wealth a private garden used to need.",
  },
];

const keep = [
  {
    icon: "leaf",
    title: "Ready before you are",
    text: "The lawn is mowed and watered the evening before, the garden lights are checked, and the chairs are set out where the morning sun lands.",
  },
  {
    icon: "cup",
    title: "Small things, done properly",
    text: "If you arrive late, the garden lights are already on, waiting for you.",
  },
  {
    icon: "chat",
    title: "One message away",
    text: "Before, during and after your stay, WhatsApp reaches us directly. No call centre, no form.",
  },
  {
    icon: "pin",
    title: "The neighbourhood, specifically",
    text: "Shivani's pick: Sukhna Lake at sunrise. It's a short drive, and worth waking up for.",
  },
] as const;

const icons: Record<string, string> = {
  leaf: '<path d="M5 20c8 0 14-6 14-15C10 5 5 10 5 20z"/><path d="M5 20l8-8"/>',
  cup: '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3v3M12 3v3"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.2A8.4 8.4 0 1 1 21 11.5z"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
};

const pleasures: [string, string][] = [
  ["Gardens", "gyms"],
  ["Tea", "tequila"],
  ["Cafés", "clubs"],
  ["Walks", "rides"],
  ["Picnics", "parties"],
  ["Board games", "video games"],
  ["Local markets", "supermarkets"],
  ["Used bookshops", "fashion stores"],
  ["Starry nights", "neon lights"],
  ["Conversations", "notifications"],
];

const homes: { slug: string; name: string; photo: Photo; line?: string; gap?: string }[] = [
  {
    slug: "garden-cottage",
    name: "Apricot Garden Cottage",
    photo: photos.cottageSunset,
    line: "A private lawn with a stone path and garden lights, at its best at dusk.",
  },
  {
    slug: "garden-courtyard",
    name: "Apricot Garden Courtyard",
    photo: photos.courtyardEvening,
    line: "A walled courtyard with a planted ledge and a patio that catches the evening light.",
  },
  {
    slug: "garden-chateau",
    name: "Apricot Garden Château",
    photo: photos.chateauExterior,
    line: "Five bedrooms named for Punjab's five rivers.",
  },
  {
    slug: "garden-care",
    name: "Apricot Garden Care",
    photo: photos.careExterior,
    line: "Step-free, near PGI and Homi Bhabha Cancer Hospital. Pets welcome.",
  },
];

const wa = contact.whatsappLink("Hi Apricot Stays, I read your story and I'd like to stay.");

// Shared class strings (page palette).
const label = "text-[13px] font-bold tracking-[0.14em] text-[#8f4a2a] uppercase";
const h2 = "font-serif text-4xl leading-tight font-medium text-[#2f4a3a] sm:text-[42px]";
const gapCls = "bg-[#e6d5bf] px-1.5 text-[#4a3b2b]";
---

<Base
  title="Our Story · Apricot Stays"
  description="Chandigarh is India's Garden City. You can visit its gardens, but you can't stay in one. Apricot is a garden you stay in, kept by Shivani for every guest."
  og={{ title: "Our Story · A garden of your own", image: hero.src, imageAlt: hero.alt }}
>
  <Navbar />

  <main id="main" class="bg-[#fbf7f0] text-[17px] leading-[1.6] text-[#3b3631]">
    <!-- 1. Opening -->
    <section
      aria-labelledby="hero-h"
      class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 pt-14 pb-16 lg:flex-row lg:items-center lg:pt-[72px] lg:pb-20"
    >
      <div class="flex flex-col gap-5 lg:flex-1">
        <p class={label}>Our story</p>
        <h1
          id="hero-h"
          class="font-serif text-5xl leading-[1.05] font-medium text-[#2f4a3a] sm:text-6xl"
        >
          A garden of your own.
        </h1>
        <p class="max-w-[34ch] text-[19px] text-[#4a443d]">
          Chandigarh is India's Garden City. You can visit its gardens: the Rose Garden, the Rock
          Garden, Leisure Valley at sunrise. But you can't stay in one. So we made gardens you can.
        </p>
      </div>
      <div class="lg:flex-[1.3]">
        <Picture
          src={hero.src}
          alt={hero.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          loading="eager"
          fetchpriority="high"
          class="block aspect-[4/3] w-full object-cover"
        />
      </div>
    </section>

    <!-- 2. Meet Shivani -->
    <section aria-labelledby="shivani-h" class="bg-[#f4ece0]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 py-16 lg:flex-row lg:items-start lg:gap-14 lg:py-[88px]">
        <div class="w-full max-w-[460px] lg:flex-1">
          <Picture
            src={shivani}
            alt="Shivani Kapoor, co-founder of Apricot Stays, smiling"
            widths={[460, 760]}
            sizes="(min-width: 1024px) 460px, 100vw"
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            class="block aspect-[4/5] w-full object-cover object-[50%_40%]"
          />
        </div>
        <div class="flex min-w-0 flex-col gap-5 lg:flex-[1.4]">
          <p class={label}>Meet Shivani</p>
          <h2 id="shivani-h" class={h2}>
            The person who keeps the gardens
          </h2>
          <p>
            Shivani Kapoor co-founded Apricot and looks after every stay, from your first WhatsApp
            message to the morning you leave.
          </p>
          <p>
            It began in her grandmother's garden in Ludhiana. Roses and apricots grew there, and
            every evening Shivani sat on the charpai while her grandmother watered the beds. That
            hour was the calmest part of her day.
          </p>
          <p
            id="name"
            class="flex items-center gap-3.5 border border-[#e3cfb6] bg-[#fbf7f0] px-[18px] py-3.5"
          >
            <svg
              width="34"
              height="34"
              viewBox="0 0 34 34"
              fill="none"
              stroke-linecap="round"
              aria-hidden="true"
              class="shrink-0"
            >
              <circle
                cx="17"
                cy="20"
                r="11"
                fill="#f2b48c"
                stroke="#b8672f"
                stroke-width="1.6"
              ></circle>
              <path d="M17 9 C16 14 16 24 17 31" stroke="#b8672f" stroke-width="1.2"></path>
              <path
                d="M18 9 C22 3 28 3 31 6 C26 9 22 10 18 9Z"
                fill="#dfe6df"
                stroke="#2f4a3a"
                stroke-width="1.4"
              ></path>
            </svg>
            <span>
              <strong class="font-semibold text-[#2f4a3a]">
                That's where our name comes from.
              </strong>{" "}
              Apricot is her grandmother's garden, shared.
            </span>
          </p>
          <p>
            Most people in Chandigarh grow up walking past beautiful gardens. Very few get to wake
            up in one. Shivani wanted to change who gets to.
          </p>
          <blockquote class="mt-3 border-t border-[#d8c8b2] pt-6 font-serif text-[26px] leading-snug text-[#2f4a3a] italic">
            <p>
              &ldquo;A garden doesn't ask anything of you. You sit, and the day gets quieter.&rdquo;
            </p>
            <footer class="mt-2.5 font-sans text-[15px] text-[#5c5148] not-italic">
              Shivani Kapoor, co-founder
            </footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 3. Everyone's private garden -->
    <section aria-labelledby="idea-h" class="bg-[#2f4a3a] text-[#f4ece0]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-12 px-6 py-16 lg:py-[88px]">
        <h2
          id="idea-h"
          class="font-serif text-4xl leading-tight font-medium text-[#fbf7f0] sm:text-[46px]"
        >
          Everyone's private garden
        </h2>
        <ol class="grid grid-cols-1 gap-10 md:grid-cols-3">
          {idea.map((step, i) => (
            <li class="flex flex-col gap-3 border-t border-[#5f7a69] pt-5">
              <span class="font-serif text-[34px] text-[#f2b48c]" aria-hidden="true">
                {i + 1}
              </span>
              <span class="text-xl font-semibold text-[#fbf7f0]">{step.title}</span>
              <span class="text-[#dfe6df]">{step.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. How Shivani keeps every garden -->
    <section
      aria-labelledby="keep-h"
      class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 py-16 lg:py-[88px]"
    >
      <h2 id="keep-h" class={h2}>
        How Shivani keeps every garden
      </h2>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {keep.map((k) => (
          <div class="flex flex-col gap-2.5">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#2f4a3a"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[k.icon]}
            />
            <h3 class="text-[19px] font-semibold text-[#2b2723]">{k.title}</h3>
            <p class="text-[15px]">
              {"gap" in k ? <span class="bg-[#ecdfcd] px-1 text-[#4a3b2b]">{k.gap}</span> : k.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Quieter pleasures -->
    <section aria-labelledby="choose-h" class="border-y border-[#e8dfd2]">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-9 px-6 py-16 lg:py-[88px]">
        <div class="flex max-w-[640px] flex-col gap-3.5">
          <p class={label}>Our kind of stay</p>
          <h2 id="choose-h" class={h2}>
            For people who like quieter pleasures.
          </h2>
          <p class="text-[#4a443d]">
            Apricot is for people who'd rather spend a morning in a garden than a night out.
          </p>
        </div>
        <ul class="grid grid-cols-1 gap-x-7 sm:grid-cols-2 lg:grid-cols-5">
          {pleasures.map(([yes, no]) => (
            <li class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-t border-[#e3d8c8] py-4">
              <span class="font-serif text-[26px] text-[#2f4a3a]">{yes}</span>
              <span class="text-[15px] text-[#6b5f53]">over {no}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5 bg-[#f4ece0] px-6 py-5">
          <span class={label}>Shivani's pick</span>
          <span class="flex flex-wrap items-baseline gap-x-2.5">
            <span class="font-serif text-2xl text-[#2f4a3a]">Sunrises</span>
            <span class="text-[15px] text-[#6b5f53]">over skyscrapers</span>
          </span>
        </div>
      </div>
    </section>

    <!-- 6. Four gardens to stay in -->
    <section
      aria-labelledby="homes-h"
      class="mx-auto flex max-w-[1200px] flex-col gap-10 px-6 py-16 lg:py-[88px]"
    >
      <h2 id="homes-h" class={h2}>
        Four gardens to stay in
      </h2>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-4">
        {homes.map((h) => (
          <a
            href={`/stays/${h.slug}`}
            class="group flex flex-col gap-3 rounded-sm text-[#3b3631] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-4 focus-visible:outline-none"
          >
            <div class="aspect-[4/3] overflow-hidden bg-[#ebe0d0]">
              <Picture
                src={h.photo.src}
                alt={h.photo.alt}
                widths={[400, 600]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
              />
            </div>
            <span class="font-serif text-[22px] text-[#2f4a3a] group-hover:underline">
              {h.name}
            </span>
            <span class="text-[15px]">
              {h.gap ? <span class="bg-[#ecdfcd] px-1 text-[#4a3b2b]">{h.gap}</span> : h.line}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- 7. Close -->
    <section aria-labelledby="close-h" class="bg-[#f4ece0]">
      <div class="mx-auto flex max-w-[760px] flex-col items-center gap-5 px-6 py-20 text-center lg:py-24">
        <p class="text-[15px] text-[#5c5148]">
          <span aria-hidden="true">★</span>
          {trust.rating} host rating · {trust.reviews} Airbnb reviews
          {trust.superhost && " · Superhost"}
        </p>
        <h2
          id="close-h"
          class="font-serif text-4xl leading-tight font-medium text-[#2f4a3a] sm:text-5xl"
        >
          Come and sit in the garden.
        </h2>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-[#2f4a3a] px-6 font-semibold text-[#fbf7f0] transition-colors hover:bg-[#1f3328] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-4 focus-visible:outline-none"
          >
            <Icon name="whatsapp" size={18} />
            Message us on WhatsApp
          </a>
          <a
            href="/#collection"
            class="inline-flex min-h-12 items-center rounded-full border-[1.5px] border-[#2f4a3a] px-6 font-semibold text-[#2f4a3a] transition-colors hover:bg-[#2f4a3a] hover:text-[#fbf7f0] focus-visible:ring-2 focus-visible:ring-[#2f4a3a] focus-visible:ring-offset-4 focus-visible:outline-none"
          >
            See the homes
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

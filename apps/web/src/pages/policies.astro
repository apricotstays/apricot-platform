---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { contact, promise } from "@apricot/brand";
import { minStayRule, policiesUpdated, properties } from "@apricot/schema";

const wa = contact.whatsappLink("Hi Apricot Stays, I have a question about booking.");
const shortName = (name: string) => name.replace(/^Apricot /, "");

const faq: {
  group: string;
  items: { q: string; a: string; link?: { href: string; text: string } }[];
}[] = [
  {
    group: "Before your stay",
    items: [
      {
        q: "How do I book?",
        a: "Message us on WhatsApp with your dates and number of guests. We confirm the price, and your dates are held once the advance is paid.",
      },
      {
        q: "Is the price on the site final?",
        a: "It's the starting weekday rate. Weekends and festivals cost more, so we confirm the exact total for your dates on WhatsApp.",
      },
      {
        q: "Can I bring my pet?",
        a: "Yes, at the Garden Cottage, Garden Courtyard and Garden Care, and at the Garden Château on request. There's a one-time cleaning fee of ₹1,000 per pet; please keep pets off beds and sofas.",
      },
      {
        q: "Is Garden Care suitable for patients and caregivers?",
        a: "Yes. It's a step-free, ground-floor one-bedroom home a few minutes from PGI and Homi Bhabha Cancer Hospital, for two guests. Longer stays are welcome, and you can change or cancel for free up to 48 hours before.",
      },
    ],
  },
  {
    group: "During your stay",
    items: [
      {
        q: "How does check-in work?",
        a: "We send directions and check-in details on WhatsApp on the day you arrive. Self check-in runs until 8 PM; arriving later is fine, just tell us.",
      },
      {
        q: "Can we order food?",
        a: "Yes. The City Club in DLF Hyde Park delivers to the door from 9:30 AM to 10 PM. Ask us for the menu link.",
      },
      {
        q: "Who do I contact if something goes wrong?",
        a: `Message us on WhatsApp at ${contact.whatsappDisplay}. You talk to us, the hosts, not a call centre.`,
      },
    ],
  },
  {
    group: "After your stay",
    items: [
      {
        q: "Can I get an invoice?",
        a: "Yes. Ask us on WhatsApp and we'll send one.",
      },
    ],
  },
  {
    group: "About Apricot",
    items: [
      {
        q: "Why is it called Apricot?",
        a: "Roses and apricots grew in our co-founder Shivani's grandmother's garden in Ludhiana. We named Apricot after that garden, and each of our homes has a garden of its own.",
        link: { href: "/our-story", text: "Read our story" },
      },
    ],
  },
];
const toc = [
  { id: "at-a-glance", label: "At a glance" },
  { id: "cancellation", label: "Cancellation & changes" },
  { id: "payment", label: "Payment" },
  { id: "check-in", label: "Check-in & checkout" },
  { id: "house-rules", label: "House rules" },
  { id: "direct-h", label: "Why book direct" },
  { id: "faq", label: "FAQ" },
];
---

<Base
  title="Stay policies & FAQ · Apricot Stays"
  description="Cancellation, payment, check-in times, house rules and answers to common questions for Apricot Stays' homes at DLF Hyde Park, New Chandigarh."
>
  <Navbar sticky={false} />

  <main
    id="main"
    class="mx-auto grid w-full max-w-7xl gap-16 px-6 pt-12 pb-20 lg:grid-cols-[minmax(0,72ch)_220px] lg:px-12"
  >
    <article class="prose-apricot min-w-0">
      <p class="eyebrow">Before you book</p>
      <h1>Stay policies &amp; FAQ</h1>
      <p class="meta">Last updated {policiesUpdated}</p>

      <p>
        Everything you'd want to know before booking, in plain words. When you book with us
        directly, these are the terms. Questions?{" "}
        <a href={wa} target="_blank" rel="noopener">
          Message us on WhatsApp
        </a>
        .
      </p>

      <p>
        <strong>{promise.name}.</strong> {promise.line}
      </p>

      <h2 id="at-a-glance">At a glance</h2>
      <div class="mt-4 overflow-x-auto border border-stone-200">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="bg-stone-50 text-stone-800">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">
                Home
              </th>
              <th scope="col" class="px-4 py-3 font-semibold">
                Check-in / out
              </th>
              <th scope="col" class="px-4 py-3 font-semibold">
                Guests
              </th>
              <th scope="col" class="px-4 py-3 font-semibold">
                Pets
              </th>
              <th scope="col" class="px-4 py-3 font-semibold">
                Minimum stay
              </th>
              <th scope="col" class="px-4 py-3 font-semibold">
                Free cancellation
              </th>
            </tr>
          </thead>
          <tbody>
            {properties.map((p) => (
              <tr class="border-t border-stone-200 text-stone-600">
                <th scope="row" class="px-4 py-3 font-semibold text-stone-800">
                  <a href={`/stays/${p.slug}`}>{shortName(p.name)}</a>
                </th>
                <td class="px-4 py-3">
                  {p.policy.checkIn} / {p.policy.checkOut}
                </td>
                <td class="px-4 py-3">{p.maxGuests}</td>
                <td class="px-4 py-3">{p.policy.pets}</td>
                <td class="px-4 py-3">{p.policy.minStay}</td>
                <td class="px-4 py-3">{p.policy.freeCancellation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="cancellation">Cancellation &amp; changes</h2>
      <p>
        Plans change. We'd rather you come later than not at all, so you always get more back as a
        stay credit than as a refund.
      </p>
      <ul>
        <li>
          <strong>Garden Cottage and Garden Courtyard:</strong> full refund up to 14 days before
          check-in. Between 7 and 14 days, 50% back or 100% as stay credit. Under 7 days,
          non-refundable.
        </li>
        <li>
          <strong>Garden Château:</strong> full refund up to 30 days before. Between 7 and 30 days,
          50% back or 100% as stay credit. Under 7 days, non-refundable. Diwali week, 24 December –
          2 January and booked events are non-refundable but can be moved once.
        </li>
        <li>
          <strong>Garden Care:</strong> change or cancel for free up to 48 hours before check-in.
          Within 48 hours, we keep the first night and refund the rest. Hospital dates move, and we
          understand.
        </li>
        <li>
          <strong>One free date change</strong> if you're more than 7 days out (Château: 30), to new
          dates within 6 months, subject to availability.
        </li>
        <li>
          <strong>Stay credit</strong> works at any Apricot home for 12 months.
        </li>
        <li>
          <strong>Changed your mind straight away?</strong> Cancel within 24 hours of booking for a
          full refund, as long as check-in is more than 7 days away.
        </li>
        <li>
          <strong>If we ever have to cancel,</strong> you get a full refund plus 10% extra as stay
          credit.
        </li>
        <li>Refunds go back the way you paid, within 7 working days.</li>
      </ul>

      <h2 id="payment">Payment</h2>
      <ul>
        <li>
          50% by UPI or bank transfer confirms your booking; the rest is due 7 days before check-in.
          Booking within 7 days of arrival? Please pay in full.
        </li>
        <li>Your advance counts toward the cancellation terms above.</li>
        <li>
          Garden Château only: a refundable security deposit of ₹20,000, collected 48 hours before
          arrival and returned within 3 working days of checkout. Any deduction comes with photos
          and a breakdown.
        </li>
      </ul>

      <h2 id="check-in">Check-in &amp; checkout</h2>
      <ul>
        <li>
          Check-in from 2 PM (Garden Château: 3 PM). Self check-in runs until 8 PM; arriving later
          is fine, just tell us.
        </li>
        <li>Checkout by 12 PM (Garden Château: 11 AM).</li>
        <li>
          <strong>Minimum stay:</strong> {minStayRule}
        </li>
        <li>
          Early check-in or late checkout is free when the home is empty the night before or after;
          we confirm the day before. Direct guests can stay until 2 PM whenever the home is free.
        </li>
        <li>
          Before you leave: gather used towels, put rubbish in the bins, switch things off and lock
          up. No need to strip the beds.
        </li>
      </ul>

      <h2 id="house-rules">House rules</h2>
      <p>
        Our homes sit in a residential society, among neighbours and gardens. A few things we ask:
      </p>
      <ol>
        <li>
          Share a government photo ID for each adult before arrival; the society gate needs it too.
          We use it only for your stay and keep it no longer than the law requires.
        </li>
        <li>
          Only registered guests stay overnight. Visitors are welcome until 10 PM; let us know who's
          coming.
        </li>
        <li>Quiet hours are 10 PM – 7 AM, with no music outdoors after 10 PM.</li>
        <li>
          No parties or events. At the Garden Château, birthdays and family dinners are welcome
          within 10 guests; anything larger by arrangement, with a higher deposit.
        </li>
        <li>
          No smoking indoors. The garden is fine, except at Garden Care, where there's no smoking
          anywhere on the premises.
        </li>
        <li>Pets are welcome (Château on request); please keep them off beds and sofas.</li>
        <li>Please leave the flowers in the garden for the next guests.</li>
        <li>If something breaks, tell us. We'll sort it out without fuss.</li>
      </ol>

      <section class="direct mt-10 bg-linen p-6" aria-labelledby="direct-h">
        <h2 id="direct-h" class="!mt-0">
          Why book with us directly
        </h2>
        <ul>
          <li>Fairer cancellation, with full stay credit instead of a partial refund.</li>
          <li>One free date change.</li>
          <li>Late checkout until 2 PM when the home is free.</li>
          <li>You talk to us, the hosts, on WhatsApp from first message to checkout.</li>
        </ul>
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="cta btn-primary mt-5 min-h-12 no-underline"
        >
          Message us on WhatsApp
        </a>
      </section>

      <h2 id="faq">FAQ</h2>
      {faq.map((g) => (
        <div class="mt-6">
          <h3 class="mb-2 text-xs font-semibold tracking-[0.15em] text-stone-500 uppercase">
            {g.group}
          </h3>
          {g.items.map((it) => (
            <details class="group border-t border-stone-200 last:border-b">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-stone-800 hover:text-apricot [&::-webkit-details-marker]:hidden">
                {it.q}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                  class="shrink-0 text-stone-500 transition-transform group-open:rotate-45"
                >
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </summary>
              <p class="mt-0 pb-4">
                {it.a}
                {it.link && (
                  <>
                    {" "}
                    <a href={it.link.href} class="underline">
                      {it.link.text}
                    </a>
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      ))}
    </article>

    <!-- In-page map (design audit item 18): sticky on wide screens, tracks the section in view. -->
    <nav aria-label="On this page" class="hidden lg:block">
      <div class="sticky top-8">
        <p class="mb-3 text-xs font-semibold tracking-[0.2em] text-stone-500 uppercase">
          On this page
        </p>
        <ul class="space-y-1 border-l border-stone-200 text-sm">
          {toc.map((t) => (
            <li>
              <a
                href={`#${t.id}`}
                data-toc={t.id}
                class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-stone-600 hover:text-stone-900 aria-[current=true]:border-apricot aria-[current=true]:font-medium aria-[current=true]:text-stone-900"
              >
                {t.label}
              </a>
            </li>
          ))}
        </ul>
        <a href={wa} target="_blank" rel="noopener" class="btn-secondary mt-6">
          Ask on WhatsApp
        </a>
      </div>
    </nav>
  </main>

  <Footer />
</Base>

<style>
  @reference "../styles/global.css";
  .prose-apricot :global(.eyebrow) {
    @apply mb-4 font-sans text-xs font-semibold tracking-[0.2em] text-stone-500 uppercase;
  }
  .prose-apricot :global(h1) {
    @apply mb-2 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl;
  }
  .prose-apricot :global(.meta) {
    @apply mb-8 text-sm text-stone-500;
  }
  .prose-apricot :global(h2) {
    @apply mt-10 mb-3 font-serif text-2xl font-normal text-stone-900;
  }
  .prose-apricot :global(p),
  .prose-apricot :global(li) {
    @apply leading-7 text-stone-600;
  }
  .prose-apricot :global(p + p) {
    @apply mt-4;
  }
  .prose-apricot :global(strong) {
    @apply font-semibold text-stone-800;
  }
  .prose-apricot :global(ul) {
    @apply mt-4 ml-5 list-disc space-y-2;
  }
  .prose-apricot :global(ol) {
    @apply mt-4 ml-5 list-decimal space-y-2;
  }
  .prose-apricot :global(a:not(.cta)) {
    @apply font-medium text-stone-900 underline underline-offset-4;
  }
</style>

<script>
  // Highlight the section in view in the "On this page" list.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const heads = links
    .map((a) => document.getElementById(a.dataset.toc ?? ""))
    .filter((h): h is HTMLElement => !!h);
  if (links.length && "IntersectionObserver" in window) {
    const mark = (id: string) =>
      links.forEach((a) => a.setAttribute("aria-current", String(a.dataset.toc === id)));
    const obs = new IntersectionObserver(
      (entries) => {
        const top = entries.filter((e) => e.isIntersecting)[0];
        if (top) mark(top.target.id);
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    heads.forEach((h) => obs.observe(h));
  }
</script>

---
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ExperiencePhoto from "../../components/ExperiencePhoto.astro";
import { contact } from "@apricot/brand";
import { loadExperiences, SOFT_LAUNCH } from "../../experiences/load";
import { groupBySection, priceLine, SECTION_SUBTITLES, slugify } from "../../experiences/core";

/*
 * /experiences — Experiences & services, arranged by Apricot Stays.
 * Content: Notion database "Garden - Services & Experiences" (see src/experiences/).
 * Soft launch: reachable from the footer only, noindex, not in the sitemap (SOFT_LAUNCH).
 *
 * Shareable filtered views, no JavaScript: /experiences#experiences and /experiences#services.
 * The tabs are plain links; CSS :target hides the other kind (style block at the end).
 * Row order follows the Section options in Notion (loadExperiences → sectionOrder).
 */
const { listings, sectionOrder } = await loadExperiences();
const groups = groupBySection(listings, sectionOrder);
const kinds = new Set(listings.map((l) => l.kind));
const showTabs = kinds.size > 1;
const askHref = contact.whatsappLink("Hi Apricot Stays, I'm looking for something during my stay:");
const btnDark = "btn-primary min-h-12";
const count = (kind?: string) => listings.filter((l) => !kind || l.kind === kind).length;
const tabs = [
  { key: "all", label: "All", n: count() },
  { key: "experiences", label: "Experiences", n: count("Experience") },
  { key: "services", label: "Services", n: count("Service") },
];
// While the catalogue is small (no section with 3+ listings), show one row with the section as a
// label on each card, and the "something else" ask as the last tile (design audit item 19).
// Group by section again once any section reaches three.
const compact = groups.length > 0 && groups.every((g) => g.listings.length < 3);
const rows = compact
  ? [
      {
        title: "",
        listings: groups.flatMap((g) => g.listings.map((l) => ({ ...l, label: g.title }))),
      },
    ]
  : groups.map((g) => ({
      title: g.title,
      listings: g.listings.map((l) => ({ ...l, label: l.kind as string })),
    }));
---

<Base
  title="Experiences & services · Apricot Stays"
  description="Things to do around Chandigarh and services at your Apricot home, arranged by Apricot Stays. Book on WhatsApp."
  noindex={SOFT_LAUNCH}
>
  <Navbar />

  <main id="main" class="es bg-white">
    <!-- Targets for /experiences#experiences and #services (filtering is pure CSS). -->
    <span id="experiences" class="es-anchor" aria-hidden="true"></span>
    <span id="services" class="es-anchor" aria-hidden="true"></span>
    <div class="container mx-auto px-6 pt-12 pb-6 sm:pt-16">
      <h1 class="mb-3 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
        Experiences &amp; services
      </h1>
      <p class="mb-8 max-w-xl text-lg leading-relaxed text-stone-600">
        Arranged by Apricot Stays, from people we know. Book on WhatsApp, and we look after the
        rest.
      </p>

      {showTabs && (
        <nav aria-label="Show" class="inline-flex gap-1 rounded border border-stone-300 p-1">
          {tabs.map((t) => (
            <a
              href={`#${t.key}`}
              data-tab={t.key}
              class="es-tab flex h-11 items-center rounded px-5 text-sm font-medium text-stone-600 hover:text-stone-900 focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              {t.label}
              <span class="ml-1.5 tabular-nums">{t.n}</span>
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="container mx-auto space-y-14 px-6 pt-6 pb-16">
      {groups.length === 0 && (
        <p class="max-w-xl text-stone-600">
          New experiences are on their way. Tell us what you're looking for and we'll arrange it.
        </p>
      )}
      {rows.map((g) => (
        <section
          aria-labelledby={g.title ? `sec-${slugify(g.title)}` : undefined}
          aria-label={g.title ? undefined : "All experiences and services"}
          class="es-section"
        >
          {g.title && (
            <h2
              id={`sec-${slugify(g.title)}`}
              class="font-serif text-2xl font-normal text-stone-900 sm:text-3xl"
            >
              {g.title}
            </h2>
          )}
          {g.title && SECTION_SUBTITLES[g.title] && (
            <p class="mt-1 text-sm text-stone-500">{SECTION_SUBTITLES[g.title]}</p>
          )}
          <ul
            class:list={[
              "grid gap-x-6 gap-y-10 sm:grid-cols-2",
              compact ? "lg:grid-cols-4" : "mt-6 lg:grid-cols-3",
            ]}
          >
            {g.listings.map((l) => (
              <li data-kind={l.kind}>
                <a href={`/experiences/${l.slug}`} class="group block">
                  <div class="relative aspect-square overflow-hidden rounded bg-stone-100">
                    <ExperiencePhoto
                      listing={l}
                      widths={[400, 600, 800]}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      class="transition-transform duration-500 group-hover:scale-105"
                    />
                    {l.badge && (
                      <span class="absolute top-3 left-3 rounded bg-white px-3 py-1 text-xs font-bold text-stone-900">
                        {l.badge}
                      </span>
                    )}
                    {l.status === "Draft" && (
                      <span class="absolute top-3 right-3 rounded bg-stone-900 px-3 py-1 text-xs font-bold text-white">
                        Draft (preview only)
                      </span>
                    )}
                  </div>
                  <p class="mt-3 text-xs font-bold tracking-[0.12em] text-stone-500 uppercase">
                    {l.label}
                  </p>
                  <h3 class="mt-1 font-medium text-stone-900 group-hover:underline">{l.title}</h3>
                  <p class="mt-1 text-sm text-stone-600">{priceLine(l)}</p>
                </a>
              </li>
            ))}
            {compact && (
              <li class="es-ask flex flex-col justify-between gap-4 rounded bg-linen p-6">
                <div>
                  <h2 class="font-serif text-2xl leading-snug font-normal text-stone-900">
                    Something else in mind?
                  </h2>
                  <p class="mt-2 text-stone-600">
                    Tell us what you need. If we know someone good, we'll arrange it.
                  </p>
                </div>
                <a href={askHref} target="_blank" rel="noopener" class="btn-secondary self-start">
                  Ask on WhatsApp
                </a>
              </li>
            )}
          </ul>
        </section>
      ))}

      {!compact && (
        <div class="flex flex-col items-start justify-between gap-4 rounded bg-linen p-6 sm:flex-row sm:items-center sm:p-8">
          <div>
            <h2 class="font-serif text-2xl font-normal text-stone-900">
              Looking for something else?
            </h2>
            <p class="mt-1 text-stone-600">
              Tell us what you need. If we know someone good, we'll arrange it.
            </p>
          </div>
          <a href={askHref} target="_blank" rel="noopener" class={btnDark}>
            Ask on WhatsApp
          </a>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Base>

<style>
  /*
   * Filtering without JavaScript. /experiences#experiences or #services makes that anchor the
   * :target; the other kind, and any row left empty, are hidden. #all (or no hash) shows everything.
   */
  .es-anchor {
    display: block;
    scroll-margin-top: 6rem;
  }
  .es:has(#experiences:target) [data-kind="Service"],
  .es:has(#services:target) [data-kind="Experience"],
  .es:has(#experiences:target) .es-section:not(:has([data-kind="Experience"])),
  .es:has(#services:target) .es-section:not(:has([data-kind="Service"])) {
    display: none;
  }
  .es:not(:has(#experiences:target, #services:target)) .es-tab[data-tab="all"],
  .es:has(#experiences:target) .es-tab[data-tab="experiences"],
  .es:has(#services:target) .es-tab[data-tab="services"] {
    background: #292524;
    color: #fff;
  }
</style>

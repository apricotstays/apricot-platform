---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/Icon.astro";
import ExperiencePhoto from "../../components/ExperiencePhoto.astro";
import { contact } from "@apricot/brand";
import { loadExperiences, SOFT_LAUNCH } from "../../experiences/load";
import { formatRupees, optionMessage, priceLine, type Listing } from "../../experiences/core";

export const getStaticPaths = (async () => {
  const { listings } = await loadExperiences();
  return listings.map((l) => ({ params: { slug: l.slug }, props: { listing: l } }));
}) satisfies GetStaticPaths;

interface Props {
  listing: Listing;
}
const { listing: l } = Astro.props;
const isExperience = l.kind === "Experience";
const request = contact.whatsappLink(`${l.whatsappText}\n\nDate:\nGuests:\nYour Apricot home:`);
const extraPhotos = l.photos.slice(1, 5).map((_, i) => i + 1);
const facts = [
  l.where && { icon: l.where === "We pick you up" ? "car" : "home", label: l.where },
  l.duration && { icon: "clock", label: l.duration },
].filter(Boolean) as { icon: "car" | "home" | "clock"; label: string }[];

const btnDark =
  "inline-flex h-12 w-full items-center justify-center gap-2 bg-stone-800 px-6 text-sm font-medium text-white transition-colors hover:bg-stone-900 focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-2 focus-visible:outline-none";
const h2 = "mb-5 font-serif text-2xl font-normal text-stone-900";
---

<Base
  title={`${l.title} · Apricot Stays`}
  description={l.description.slice(0, 155) || `${l.title}, arranged by Apricot Stays.`}
  noindex={SOFT_LAUNCH || l.status !== "Live"}
>
  <Navbar sticky={false} />

  <main id="main" class="bg-white pt-8 sm:pt-10">
    <div class="container mx-auto px-6">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-stone-500">
        <a href="/experiences" class="hover:text-stone-800">
          Experiences &amp; services
        </a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{l.title}</span>
      </nav>
      {l.status === "Draft" && (
        <p class="mb-6 rounded-lg bg-stone-900 px-4 py-3 text-sm text-white">
          Draft — shown on preview links only. Set Status to Live in Notion to publish.
          {l.placeholders.length > 0 && <> Still to fill: {l.placeholders.join(", ")}.</>}
        </p>
      )}
      <p class="mb-2 text-xs font-bold tracking-[0.12em] text-stone-500 uppercase">
        {l.kind} · {l.section}
      </p>
      <h1 class="mb-8 max-w-4xl font-serif text-3xl leading-tight font-normal text-stone-900 sm:text-4xl">
        {l.title}
      </h1>

      <div
        class:list={[
          "mb-12 grid gap-2 overflow-hidden rounded-2xl",
          extraPhotos.length > 0 && "md:grid-cols-2",
        ]}
      >
        <div
          class:list={[
            "bg-stone-100",
            extraPhotos.length > 0
              ? "aspect-square md:row-span-2"
              : "aspect-[16/9] max-h-[420px] w-full",
          ]}
        >
          <ExperiencePhoto
            listing={l}
            widths={[480, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            eager
          />
        </div>
        {extraPhotos.length > 0 && (
          <div class="hidden grid-cols-2 grid-rows-2 gap-2 md:grid">
            {extraPhotos.map((i) => (
              <div class="aspect-square bg-stone-100">
                <ExperiencePhoto listing={l} index={i} widths={[300, 600]} sizes="25vw" />
              </div>
            ))}
          </div>
        )}
      </div>
      {l.photoCredit && l.photos.length > 0 && (
        <p class="-mt-10 mb-12 text-xs text-stone-500">{l.photoCredit}</p>
      )}
    </div>

    <div class="container mx-auto px-6 pb-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div class="max-w-3xl space-y-10">
          {facts.length > 0 && (
            <ul class="flex flex-wrap gap-6 border-b border-stone-200 pb-6 text-stone-700">
              {facts.map((f) => (
                <li class="flex items-center gap-2">
                  <Icon name={f.icon} size={20} />
                  <span>{f.label}</span>
                </li>
              ))}
            </ul>
          )}

          {l.description && <p class="text-lg leading-relaxed text-stone-600">{l.description}</p>}

          {isExperience && l.steps.length > 0 && (
            <section aria-labelledby="steps-h" class="border-t border-stone-200 pt-10">
              <h2 id="steps-h" class={h2}>
                How the day goes
              </h2>
              <ol class="space-y-5">
                {l.steps.map((s, i) => (
                  <li class="grid grid-cols-[2rem_1fr] gap-4">
                    <span
                      class="grid h-8 w-8 place-items-center rounded-full border border-stone-300 font-serif text-sm text-stone-700"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <p class="font-medium text-stone-900">{s.title}</p>
                      {s.text && <p class="text-stone-600">{s.text}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {l.options.length > 0 && (
            <section aria-labelledby="options-h" class="border-t border-stone-200 pt-10">
              <h2 id="options-h" class={h2}>
                {isExperience ? "Choose your trip" : "Choose an option"}
              </h2>
              <ul class="space-y-3">
                {l.options.map((o) => (
                  <li class="flex flex-col gap-3 rounded-xl border border-stone-200 p-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <p class="font-medium text-stone-900">{o.name}</p>
                      <p class="text-sm text-stone-600">
                        {[o.duration, l.showPrice && o.price != null ? formatRupees(o.price) : ""]
                          .filter(Boolean)
                          .join(" · ")}
                      </p>
                    </div>
                    <a
                      href={contact.whatsappLink(optionMessage(l, o))}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex h-11 shrink-0 items-center justify-center gap-2 border border-stone-800 px-4 text-sm font-medium text-stone-800 transition-colors hover:bg-stone-800 hover:text-white focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-2 focus-visible:outline-none"
                    >
                      <Icon name="whatsapp" size={16} />
                      Ask for this<span class="sr-only">: {o.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {l.included.length > 0 && (
            <section aria-labelledby="inc-h" class="border-t border-stone-200 pt-10">
              <h2 id="inc-h" class={h2}>
                What's included
              </h2>
              <ul class="grid gap-3 sm:grid-cols-2">
                {l.included.map((i) => (
                  <li class="flex items-start gap-3 text-stone-700">
                    <Icon name="check" size={18} class="mt-1 shrink-0 text-sage" />
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
              {l.priceNote && <p class="mt-4 text-sm text-stone-500">{l.priceNote}.</p>}
            </section>
          )}

          <section aria-labelledby="by-h" class="flex gap-4 border-t border-stone-200 pt-10">
            <span
              class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-sand font-serif text-xl font-bold text-stone-800"
              aria-hidden="true"
            >
              A
            </span>
            <div>
              <h2 id="by-h" class="mb-1 font-serif text-2xl font-normal text-stone-900">
                Arranged by Apricot Stays
              </h2>
              <p class="text-stone-600">
                One WhatsApp chat for everything. We confirm the details with you before anything is
                booked.
              </p>
            </div>
          </section>

          {(l.thingsToKnow.length > 0 || l.cancellation || l.leadTime) && (
            <section aria-labelledby="know-h" class="border-t border-stone-200 pt-10">
              <h2 id="know-h" class={h2}>
                Things to know
              </h2>
              <dl class="grid gap-6 sm:grid-cols-2">
                {l.leadTime && (
                  <div>
                    <dt class="font-medium text-stone-900">Booking</dt>
                    <dd class="mt-1 text-stone-600">{l.leadTime}</dd>
                  </div>
                )}
                {l.thingsToKnow.map((t) => (
                  <div>
                    <dt class="font-medium text-stone-900">{t.text ? t.title : "Good to know"}</dt>
                    <dd class="mt-1 text-stone-600">{t.text || t.title}</dd>
                  </div>
                ))}
                {l.cancellation && (
                  <div>
                    <dt class="font-medium text-stone-900">Cancellation</dt>
                    <dd class="mt-1 text-stone-600">{l.cancellation}</dd>
                  </div>
                )}
              </dl>
            </section>
          )}
        </div>

        <aside aria-label="Request" class="lg:sticky lg:top-6 lg:self-start">
          <div class="rounded-2xl border border-stone-200 p-6 shadow-[0_6px_20px_rgba(0,0,0,0.08)]">
            <p class="font-serif text-2xl text-stone-900">{priceLine(l)}</p>
            {l.priceNote && <p class="mt-1 text-sm text-stone-500">{l.priceNote}</p>}
            <a href={request} target="_blank" rel="noopener" class:list={[btnDark, "mt-5"]}>
              <Icon name="whatsapp" size={18} />
              Request on WhatsApp
            </a>
            <p class="mt-3 text-center text-sm text-stone-500">
              Nothing is charged until we confirm.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <!-- Phones: the request button stays in reach. -->
  <div class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-between gap-3 border-t border-stone-200 bg-white px-4 py-3 lg:hidden">
    <p class="text-sm font-medium text-stone-900">{priceLine(l)}</p>
    <a
      href={request}
      target="_blank"
      rel="noopener"
      class="inline-flex h-11 items-center gap-2 bg-stone-800 px-4 text-sm font-medium text-white"
    >
      <Icon name="whatsapp" size={16} />
      Request
    </a>
  </div>
  <div class="h-16 lg:hidden" aria-hidden="true"></div>

  <Footer />
</Base>

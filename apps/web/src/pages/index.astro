---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { properties } from "@apricot/schema";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Apricot Stays",
  url: "https://apricotstays.in/",
  areaServed: "Chandigarh Tricity, India",
};
---

<Base
  title="Apricot Stays · Boutique homes in the Chandigarh Tricity"
  description="Apricot Stays is a small collection of boutique homes across the Chandigarh Tricity. Our new website is on its way — chat with us on WhatsApp to book."
  og={{
    title: "Apricot Stays · Stay like you live here",
    description: "Boutique homes across the Chandigarh Tricity. Our new website is on its way.",
  }}
  jsonLd={jsonLd}
>
  <header>
    <div class="wrap">
      <a class="brand" href="/" aria-label="Apricot Stays home">
        <Logo />
        <span>Apricot Stays</span>
      </a>
    </div>
  </header>

  <main>
    <div class="wrap hero">
      <section>
        <div class="eyebrow">
          <i></i>New website coming soon
        </div>
        <h1>
          Stay like you <em>live</em> here.
        </h1>
        <p class="lede">
          A small collection of boutique homes across the Chandigarh Tricity, each one kept the way
          we'd keep our own.
        </p>

        <div class="ctas">
          <a
            class="btn btn-primary"
            id="wa"
            href="https://wa.me/WHATSAPP_NUMBER?text=Hi%20Apricot%20Stays%2C%20I%27d%20like%20to%20know%20about%20availability."
            target="_blank"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"></path>
            </svg>
            Chat on WhatsApp
          </a>
          <a
            class="btn btn-ghost"
            href="https://www.instagram.com/INSTAGRAM_HANDLE/"
            target="_blank"
            rel="noopener"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
            Follow on Instagram
          </a>
        </div>

        <form
          class="notify"
          name="notify"
          method="POST"
          action="/thanks.html"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="notify" />
          <p class="hidden">
            <label>
              Leave this empty <input name="bot-field" />
            </label>
          </p>
          <label for="email">Hear first when we launch, plus early-guest offers.</label>
          <div class="field">
            <input
              id="email"
              type="email"
              name="email"
              placeholder="you@email.com"
              required
              autocomplete="email"
            />
            <button type="submit">Notify me</button>
          </div>
        </form>
      </section>

      <aside class="homes" aria-label="Our homes">
        <svg class="art" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="98" fill="#F6E2CF"></circle>
          <circle cx="100" cy="100" r="66" fill="#F1CDAA"></circle>
          <circle cx="100" cy="100" r="34" fill="#E9AE7D"></circle>
        </svg>
        <h2>Our homes</h2>
        <ol>
          {properties.map((p, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <span class="name">
                {p.name}
                {p.tag && <span class="tag">{p.tag}</span>}
              </span>
            </li>
          ))}
        </ol>
        <p>
          Photos, details and direct booking are coming to this page soon. Until then, message us
          for availability and rates.
        </p>
      </aside>
    </div>
  </main>

  <footer>
    <div class="wrap">
      <span>
        © <span id="y">2026</span> Apricot Stays · Chandigarh Tricity
      </span>
      <a href="https://www.instagram.com/INSTAGRAM_HANDLE/" target="_blank" rel="noopener">
        @INSTAGRAM_HANDLE
      </a>
    </div>
  </footer>
  <script is:inline>
    document.getElementById("y").textContent = new Date().getFullYear();
    // Hide any link whose contact detail hasn't been filled in yet
    document
      .querySelectorAll('a[href*="WHATSAPP_NUMBER"],a[href*="INSTAGRAM_HANDLE"]')
      .forEach((a) => (a.style.display = "none"));
  </script>
</Base>

<style is:global>
  body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  header {
    padding: 28px 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .brand svg {
    width: 34px;
    height: 34px;
    flex: none;
  }
  .brand span {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 24px 0 56px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--apricot-deep);
    margin-bottom: 22px;
  }
  .eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--apricot);
    box-shadow: 0 0 0 0 rgba(227, 135, 75, 0.5);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(227, 135, 75, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(227, 135, 75, 0);
    }
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6.4vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }
  h1 em {
    font-style: italic;
    color: var(--apricot-deep);
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 34ch;
    margin-bottom: 34px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .btn svg {
    width: 20px;
    height: 20px;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--white);
  }
  .btn-primary:hover {
    background: #4a3527;
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1.5px solid var(--line);
    color: var(--ink);
  }
  .btn-ghost:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }

  .notify {
    max-width: 440px;
  }
  .notify label {
    display: block;
    font-size: 14px;
    color: var(--ink-2);
    margin-bottom: 10px;
  }
  .field {
    display: flex;
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 5px;
    transition: border-color 0.15s;
  }
  .field:focus-within {
    border-color: var(--apricot);
  }
  .field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 16px;
    padding: 10px 16px;
    color: var(--ink);
    outline: none;
  }
  .field button {
    border: 0;
    background: var(--apricot);
    color: var(--white);
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .field button:hover {
    background: var(--apricot-deep);
  }
  .hidden {
    position: absolute;
    left: -9999px;
  }

  .homes {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 34px 32px;
    position: relative;
    overflow: hidden;
  }
  .homes .art {
    position: absolute;
    right: -50px;
    top: -50px;
    width: 230px;
    height: 230px;
    opacity: 0.9;
  }
  .homes h2 {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 22px;
    position: relative;
  }
  .homes ol {
    list-style: none;
    position: relative;
  }
  .homes li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .homes li:last-child {
    padding-bottom: 4px;
  }
  .homes .n {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--apricot-deep);
    font-size: 16px;
    width: 24px;
    flex: none;
  }
  .homes .name {
    font-family: var(--font-display);
    font-size: 27px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .homes .tag {
    display: block;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    color: var(--ink-2);
    margin-top: 4px;
    letter-spacing: 0;
  }
  .homes p {
    margin-top: 22px;
    font-size: 15px;
    color: var(--ink-2);
    position: relative;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 22px 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  footer .wrap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  footer a {
    text-decoration: none;
  }
  footer a:hover {
    color: var(--ink);
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    main {
      padding-top: 8px;
    }
  }
  @media (max-width: 480px) {
    .wrap {
      padding: 0 16px;
    }
    header {
      padding: 20px 0;
    }
    .lede {
      font-size: 17px;
    }
    .btn {
      width: 100%;
      justify-content: center;
    }
    .homes {
      padding: 26px 22px;
      border-radius: 22px;
    }
    .homes .name {
      font-size: 23px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow i {
      animation: none;
    }
    .btn {
      transition: none;
    }
  }
</style>

---
import { Picture, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import TrustLine from "../components/TrustLine.astro";
import MushroomGardenCard from "../components/MushroomGardenCard.astro";
import SectionRule from "../components/SectionRule.astro";
import { fromLine, properties, ratesChecked } from "@apricot/schema";
import { brand, contact, promise } from "@apricot/brand";
import { galleries, photos } from "../data/media";
import { waysToStay } from "../data/ways-to-stay";

const wa = (text: string) => contact.whatsappLink(text);
const availability = wa(
  "Hi Apricot Stays, I'd like to check availability.\n\nDates:\nGuests:\nHome (if any):",
);

// Hero: one optimised poster, used by the <video> (desktop) and the <picture> (mobile / reduced motion).
const hero = photos.courtyardDay;
const poster = await getImage({ src: hero.src, width: 1440, format: "webp", quality: 70 });

const amenities = [
  {
    icon: "wifi",
    title: "High-speed Wi-Fi",
    text: "Fast, reliable internet in every home — good for workcations.",
  },
  { icon: "power", title: "24/7 power backup", text: "No interruptions, whatever the weather." },
  {
    icon: "tree",
    title: "Gardens & courtyards",
    text: "Your own green corner to unwind, read or watch the evening light.",
  },
  {
    icon: "shield",
    title: "Gated security",
    text: "All homes sit inside the gated DLF Hyde Park estate.",
  },
  {
    icon: "building",
    title: "Clubhouse access",
    text: "Use of the DLF Hyde Park clubhouse during your stay.",
  },
  {
    icon: "users",
    title: "Room to gather",
    text: "The Château sleeps ten, with a full kitchen and firepit.",
  },
] as const;

const orgId = `${brand.url}/#organization`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: brand.name,
      url: `${brand.url}/`,
      logo: `${brand.url}/favicon.svg`,
      slogan: brand.tagline,
      email: contact.email,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "reservations",
        telephone: contact.whatsappE164,
        url: "https://wa.me/919740544873",
      },
    },
    ...properties.map((p) => ({
      "@type": "LodgingBusiness",
      "@id": `${brand.url}/stays/${p.slug}#lodging`,
      name: p.name,
      url: `${brand.url}/stays/${p.slug}`,
      description: p.summary,
      brand: { "@id": orgId },
      telephone: contact.whatsappE164,
      address: {
        "@type": "PostalAddress",
        addressLocality: contact.address.locality,
        addressRegion: contact.address.region,
        addressCountry: contact.address.country,
      },
      geo: { "@type": "GeoCoordinates", ...contact.address.geo },
      priceRange: fromLine(p),
      ...(p.airbnbUrl ? { sameAs: [p.airbnbUrl] } : {}),
    })),
  ],
};
---

<Base
  title="Apricot Stays · Boutique homes in New Chandigarh"
  description="A small collection of boutique homes at DLF Hyde Park, New Chandigarh — a garden cottage, a terracotta courtyard, a five-bedroom château and a care stay near PGI, each with a garden of its own. Book on WhatsApp."
  og={{ title: "Apricot Stays · Stay like you live here", image: hero.src, imageAlt: hero.alt }}
  jsonLd={jsonLd}
>
  <Navbar />

  <main id="main">
    <!-- Hero -->
    <section class="relative h-[calc(100svh-73px)] min-h-[420px] w-full overflow-hidden bg-stone-200">
      <h1 class="sr-only">Apricot Stays — boutique homes at DLF Hyde Park, New Chandigarh</h1>
      <Picture
        src={hero.src}
        alt={hero.alt}
        widths={[480, 768, 1080, 1440]}
        sizes="100vw"
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <video
        class="absolute inset-0 hidden h-full w-full object-cover md:block motion-reduce:hidden"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster.src}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/media/hero.mp4" type="video/mp4" media="(min-width: 768px)" />
      </video>
    </section>

    <!-- The Apricot promise -->
    <section id="promise" class="bg-linen py-14 sm:py-16">
      <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:px-12">
        <div>
          <p class="mb-3 font-sans text-xs font-semibold tracking-[0.2em] text-[#2f4a3a] uppercase">
            The Apricot promise
          </p>
          <h2 class="font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            {promise.name}.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-stone-700">
            {promise.line} Step out in the morning and it's yours.
          </p>
        </div>
        <ul class="space-y-3 text-[15px] text-stone-700">
          {properties.map((p) => (
            <li class="flex flex-col gap-0.5 border-b border-stone-300/60 pb-3 sm:flex-row sm:gap-4">
              <a
                href={`/stays/${p.slug}`}
                class="font-semibold text-stone-900 hover:text-apricot sm:w-44 sm:shrink-0"
              >
                {p.name.replace(/^Apricot /, "")}
              </a>
              <span>{p.garden}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Our Collection -->
    <section
      id="collection"
      class="scroll-mt-20 border-b border-stone-100 bg-white py-16 sm:py-20 lg:py-24"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mb-16 text-center">
          <SectionRule center />
          <h2 class="font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            Our Collection
          </h2>
          <TrustLine class="mt-4" />
        </div>
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2">
          {properties.map((p) => {
            const cover = galleries[p.slug][0];
            return (
              <a
                href={`/stays/${p.slug}`}
                class="reveal group block rounded-sm focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 focus-visible:outline-none"
              >
                <div class="relative mb-4 aspect-[4/3] overflow-hidden bg-stone-100">
                  <Picture
                    src={cover.src}
                    alt={cover.alt}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
                  />
                </div>
                <div class="mt-5">
                  <h3 class="mb-1 font-sans text-base font-normal tracking-[0.08em] text-stone-800 uppercase transition-colors group-hover:text-apricot">
                    {p.name}
                  </h3>
                  <p class="font-sans text-xs font-light tracking-[0.2em] text-stone-500 uppercase">
                    {p.locality}
                  </p>
                  <p class="mt-2 font-sans text-sm text-stone-700">{fromLine(p)}</p>
                </div>
              </a>
            );
          })}
          <MushroomGardenCard />
        </div>
        <p class="mt-10 text-center text-sm text-stone-500">
          Starting weekday rates. We confirm the exact price for your dates on WhatsApp. Rates
          checked {ratesChecked}.
        </p>
      </div>
    </section>

    <!-- Ways to stay (use-case pages) -->
    <section
      id="ways-to-stay"
      class="scroll-mt-20 border-b border-stone-100 bg-stone-50 py-16 sm:py-20"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mb-12 text-center">
          <SectionRule center />
          <p class="mb-3 font-sans text-xs tracking-[0.2em] text-stone-500 uppercase">
            Ways to stay
          </p>
          <h2 class="font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            What brings you to Chandigarh?
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {waysToStay.map((w) => {
            const img = galleries[w.homes[0]][0];
            const names = w.homes
              .map((slug) => properties.find((p) => p.slug === slug)!.name.replace(/^Apricot /, ""))
              .join(" · ");
            return (
              <a
                href={`/ways-to-stay/${w.slug}`}
                class="reveal group flex flex-col border border-stone-200 bg-white focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 focus-visible:outline-none"
              >
                <div class="aspect-[4/3] overflow-hidden bg-stone-100">
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={[400, 600]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <h3 class="font-serif text-xl text-stone-900 group-hover:text-apricot">
                    {w.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-stone-600">{w.cardLine}</p>
                  <p class="mt-auto pt-2 text-sm font-medium text-stone-800">{names} &rarr;</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- The Garden Club -->
    <section class="bg-cream py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-24">
          <div class="reveal order-2 lg:order-1">
            <SectionRule />
            <h2 class="mb-6 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
              The Garden Club
            </h2>
            <p class="mb-6 max-w-md font-sans text-base leading-7 font-normal text-stone-600">
              The Garden Club is our way of welcoming returning guests into a calmer, greener rhythm
              of stay. Members enjoy priority bookings, preferred rates, and thoughtful privileges
              such as complimentary early check-in and handpicked local experiences that help you
              slow down and settle in.
            </p>
            <p class="mb-8 font-serif text-base text-stone-600 italic">
              Root yourself. Stay awhile.
            </p>
            <a
              href={wa("Hi Apricot Stays, I'd like to know more about the Garden Club.")}
              target="_blank"
              rel="noopener"
              class="btn-link"
            >
              Ask about membership
            </a>
          </div>
          <div class="reveal order-1 lg:order-2">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <Picture
                src={photos.courtyardPatio.src}
                alt={photos.courtyardPatio.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experiences -->
    <section class="border-b border-stone-100 bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-24">
          <div class="reveal">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <Picture
                src={photos.courtyardDining.src}
                alt={photos.courtyardDining.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                formats={["avif", "webp"]}
                fallbackFormat="jpg"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div class="reveal">
            <SectionRule />
            <h2 class="mb-6 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
              Experiences
            </h2>
            <p class="mb-8 max-w-md font-sans text-base leading-7 font-normal text-stone-600">
              Holidays make explorers of all of us. Our homes offer an intimate view of local living
              in the Tricity — old haunts seen with new eyes, and new favourites found with a keen
              curiosity. Ask us for our own list of local favourites.
            </p>
            <a
              href={wa(
                "Hi Apricot Stays, could you share your favourite local places in the Tricity?",
              )}
              target="_blank"
              rel="noopener"
              class="btn-link"
            >
              Ask for local tips
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Story (teaser; full story at /our-story) -->
    <section id="story" class="scroll-mt-20 bg-linen py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="flex flex-col items-center gap-12 lg:flex-row lg:gap-16">
          <div class="reveal w-full lg:w-1/2">
            <Picture
              src={photos.courtyardEvening.src}
              alt={photos.courtyardEvening.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              class="h-[360px] w-full object-cover shadow-2xl sm:h-[460px]"
            />
          </div>
          <div class="reveal w-full lg:w-1/2">
            <div class="mb-5 h-px w-12 bg-bronze" aria-hidden="true"></div>
            <h2 class="mb-6 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
              Our Story
            </h2>
            <p class="mb-5 max-w-md font-sans text-base leading-7 font-normal text-stone-600">
              Chandigarh is India's Garden City. You can visit its gardens, but you can't stay in
              one.
            </p>
            <p class="mb-8 max-w-md font-sans text-base leading-7 font-normal text-stone-600">
              Apricot is a garden you stay in, kept by Shivani for every guest as if it were her
              own.
            </p>
            <a
              href="/our-story"
              class="inline-flex min-h-11 items-center gap-2 font-sans text-[15px] font-semibold text-stone-800 underline underline-offset-[6px] hover:text-stone-950"
            >
              Read our story
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Thoughtful Amenities -->
    <section
      id="amenities"
      class="scroll-mt-20 border-t border-stone-200/80 bg-stone-50 py-16 sm:py-20 lg:py-24"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mx-auto mb-16 max-w-2xl text-center">
          <SectionRule center />
          <h2 class="mb-4 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            Thoughtful Amenities
          </h2>
          <p class="font-sans text-base leading-7 font-normal text-stone-600">
            We've curated every detail to make your stay as comfortable as it is memorable.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {amenities.map((a) => (
            <div class="reveal group border border-stone-100 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-md">
              <div class="mb-6 flex h-12 w-12 items-center justify-center bg-pebble text-sage transition-all duration-300 group-hover:scale-110 group-hover:bg-sage/10 motion-reduce:transform-none">
                <Icon name={a.icon} />
              </div>
              <h3 class="t-h3 mb-3">{a.title}</h3>
              <p class="leading-7 text-stone-600">{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Also on Airbnb -->
    <section class="border-t border-stone-100 bg-white py-14">
      <div class="mx-auto max-w-5xl px-6 text-center">
        <p class="mb-6 font-sans text-[0.65rem] tracking-[0.2em] text-stone-500 uppercase">
          Also on Airbnb
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {properties
            .filter((p) => p.airbnbUrl)
            .map((p) => (
              <a
                href={p.airbnbUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 font-sans text-sm text-stone-600 hover:text-stone-900"
              >
                {p.name}
                <Icon name="external" size={14} />
              </a>
            ))}
        </div>
      </div>
    </section>

    <!-- Pre-footer CTA -->
    <section class="bg-stone-900 px-6 py-24 text-center text-white">
      <div class="mx-auto max-w-2xl">
        <h2 class="mb-6 font-serif text-4xl leading-tight font-normal sm:text-5xl">
          Ready to unwind?
        </h2>
        <p class="mb-8 text-lg text-stone-300">
          Message us on WhatsApp for availability and the price for your dates.
        </p>
        <a
          href={availability}
          target="_blank"
          rel="noopener"
          class="btn-primary btn-lg focus-visible:ring-offset-stone-900"
        >
          <Icon name="whatsapp" size={20} />
          Check availability
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

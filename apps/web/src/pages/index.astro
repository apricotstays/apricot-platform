---
import { Picture, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import TrustLine from "../components/TrustLine.astro";
import MushroomGardenCard from "../components/MushroomGardenCard.astro";
import SectionRule from "../components/SectionRule.astro";
import ExperiencePhoto from "../components/ExperiencePhoto.astro";
import { loadExperiences } from "../experiences/load";
import { fromLine, properties, ratesChecked } from "@apricot/schema";
import { brand, contact, promise, trust } from "@apricot/brand";
import { reviews } from "../data/reviews";
import { galleries, photos } from "../data/media";
import { waysToStay } from "../data/ways-to-stay";

const wa = (text: string) => contact.whatsappLink(text);
const availability = wa(
  "Hi Apricot Stays, I'd like to check availability.\n\nDates:\nGuests:\nHome (if any):",
);

// Hero: one optimised poster, used by the <video> (desktop) and the <picture> (mobile / reduced motion).
const hero = photos.courtyardDay;
const { listings: experiences } = await loadExperiences();
const more = [
  {
    title: "The Garden Club",
    line: "For returning guests: priority bookings, preferred rates, complimentary early check-in and handpicked local experiences.",
    cta: "Ask about membership",
    href: wa("Hi Apricot Stays, I'd like to know more about the Garden Club."),
    external: true,
    photo: photos.courtyardPatio,
  },
  {
    title: "Our story",
    line: "Chandigarh is India's Garden City. You can visit its gardens, but you can't stay in one. So we made gardens you can.",
    cta: "Read our story",
    href: "/our-story",
    external: false,
    photo: photos.courtyardEvening,
  },
];
const poster = await getImage({ src: hero.src, width: 1440, format: "webp", quality: 70 });

const amenities = [
  {
    icon: "wifi",
    title: "Fast Wi-Fi",
    text: "In every home, good for workcations; 100 Mbps at the Cottage.",
  },
  { icon: "power", title: "24/7 power backup", text: "No interruptions, whatever the weather." },
  {
    icon: "tree",
    title: "A private garden",
    text: "A lawn, garden or courtyard of your own at every home. Never shared.",
  },
  {
    icon: "shield",
    title: "Gated security",
    text: "All homes sit inside the gated DLF Hyde Park estate.",
  },
  {
    icon: "building",
    title: "Clubhouse access",
    text: "Use of the DLF Hyde Park clubhouse during your stay.",
  },
  {
    icon: "users",
    title: "Room to gather",
    text: "The Château sleeps ten, with a full kitchen and firepit.",
  },
] as const;

const orgId = `${brand.url}/#organization`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: brand.name,
      url: `${brand.url}/`,
      logo: `${brand.url}/favicon.svg`,
      slogan: brand.tagline,
      email: contact.email,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "reservations",
        telephone: contact.whatsappE164,
        url: "https://wa.me/919740544873",
      },
    },
    ...properties.map((p) => ({
      "@type": "LodgingBusiness",
      "@id": `${brand.url}/stays/${p.slug}#lodging`,
      name: p.name,
      url: `${brand.url}/stays/${p.slug}`,
      description: p.summary,
      brand: { "@id": orgId },
      telephone: contact.whatsappE164,
      address: {
        "@type": "PostalAddress",
        addressLocality: contact.address.locality,
        addressRegion: contact.address.region,
        addressCountry: contact.address.country,
      },
      geo: { "@type": "GeoCoordinates", ...contact.address.geo },
      priceRange: fromLine(p),
      ...(p.airbnbUrl ? { sameAs: [p.airbnbUrl] } : {}),
    })),
  ],
};
// Ways to stay cards show the moment, not the building (design audit item 10):
// the Collection grid above already uses each home's exterior.
const wayPhotos: Record<string, (typeof photos)[keyof typeof photos]> = {
  "garden-for-two": photos.courtyardDining,
  "family-gatherings": photos.chateauDining,
  "hospital-visits": photos.careLiving,
};
// Collection cards (design audit item 08): say what differs between homes, not what they share.
const cardFacts = (p: (typeof properties)[number]) =>
  [`${p.maxGuests} guests`, p.bedrooms ? `${p.bedrooms} bedroom${p.bedrooms > 1 ? "s" : ""}` : null]
    .filter(Boolean)
    .join(" · ");
const cardRating = (slug: string) => {
  const r = reviews[slug];
  if (r?.listing?.rating) return { kind: "rating", text: r.listing.rating } as const;
  if (r?.isNew) return { kind: "new", text: "New" } as const;
  return null;
};
---

<Base
  title="Apricot Stays · Boutique homes in New Chandigarh"
  description="A small collection of boutique homes at DLF Hyde Park, New Chandigarh — a garden cottage, a terracotta courtyard, a five-bedroom château and a care stay near PGI, each with a garden of its own. Book on WhatsApp."
  og={{ title: "Apricot Stays · Stay like you live here", image: hero.src, imageAlt: hero.alt }}
  jsonLd={jsonLd}
>
  <Navbar />

  <main id="main">
    <!-- Hero -->
    <section class="relative h-[calc(100svh-73px)] min-h-[420px] w-full overflow-hidden bg-stone-900">
      <Picture
        src={hero.src}
        alt={hero.alt}
        widths={[480, 768, 1080, 1440]}
        sizes="100vw"
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <video
        class="absolute inset-0 hidden h-full w-full object-cover md:block motion-reduce:hidden"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={poster.src}
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/media/hero.mp4" type="video/mp4" media="(min-width: 768px)" />
      </video>
      <!-- Promise, action and proof in the first screen (design audit item 01). The scrim keeps
           white text readable over the photo and every frame of the video. -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent from-25% via-stone-950/50 via-55% to-stone-950/90"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-x-0 bottom-0">
        <div
          data-hero-copy
          class="mx-auto flex max-w-7xl flex-col items-start gap-4 px-6 pb-10 text-white [text-shadow:0_1px_10px_rgb(0_0_0/0.5)] sm:pb-14 lg:px-12"
        >
          <p class="text-xs font-medium tracking-[0.2em] uppercase">Chandigarh</p>
          <h1 class="max-w-3xl font-serif text-5xl leading-[1.05] font-normal sm:text-6xl lg:text-7xl">
            <span class="sr-only">Apricot Stays, boutique homes in New Chandigarh: </span>
            {promise.name}.
          </h1>
          <p class="max-w-xl text-base sm:text-lg">
            Four homes, each with a private garden. Never shared.
          </p>
          <a
            href={availability}
            target="_blank"
            rel="noopener"
            class="btn-primary btn-lg mt-2 [text-shadow:none]"
            aria-label="Check dates on WhatsApp"
          >
            <Icon name="whatsapp" size={20} />
            Check dates on WhatsApp
          </a>
          <p class="inline-flex items-center gap-1.5 text-sm">
            <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" class="fill-gold">
              <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path>
            </svg>
            {trust.rating} host rating{trust.superhost && " · Superhost"}
          </p>
        </div>
      </div>
    </section>

    <!-- The promise band was removed (design review round 2, item 08, CK): the hero states the
         promise and each collection card names its garden. -->
    <!-- Our Collection -->
    <section
      id="collection"
      class="scroll-mt-20 border-b border-stone-100 bg-white py-16 sm:py-20 lg:py-24"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mb-16 text-center">
          <SectionRule center />
          <h2 class="font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            Our Collection
          </h2>
          <TrustLine class="mt-4" />
          <p class="mt-3 text-sm text-stone-600">
            All four homes are inside DLF Hyde Park, New Chandigarh. {promise.line}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2">
          {properties.map((p) => {
            const cover = galleries[p.slug][0];
            const badge = cardRating(p.slug);
            return (
              <a
                href={`/stays/${p.slug}`}
                class="reveal group block rounded-sm focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 focus-visible:outline-none"
              >
                <div class="relative mb-4 aspect-[4/3] overflow-hidden bg-stone-100">
                  <Picture
                    src={cover.src}
                    alt={cover.alt}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
                  />
                </div>
                <div class="mt-5">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="font-serif text-2xl leading-snug text-stone-900 transition-colors group-hover:text-apricot">
                      <span class="sr-only">Apricot </span>
                      {p.name.replace(/^Apricot /, "")}
                    </h3>
                    {badge?.kind === "rating" && (
                      <span class="inline-flex shrink-0 items-center gap-1 text-sm text-stone-700">
                        <svg
                          viewBox="0 0 20 20"
                          width="13"
                          height="13"
                          aria-hidden="true"
                          class="fill-gold"
                        >
                          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path>
                        </svg>
                        {badge.text}
                        <span class="sr-only"> on Airbnb</span>
                      </span>
                    )}
                    {badge?.kind === "new" && (
                      <span class="shrink-0 text-xs tracking-[0.15em] text-stone-600 uppercase">
                        New
                      </span>
                    )}
                  </div>
                  <p class="mt-1 text-sm text-stone-600">
                    {cardFacts(p)} · {p.garden.toLowerCase()}
                  </p>
                  <p class="mt-2 font-sans text-sm text-stone-700">
                    {fromLine(p)}
                    <span class="text-stone-500"> · weekday rate</span>
                  </p>
                </div>
              </a>
            );
          })}
        </div>
        <p class="mt-8 text-sm text-stone-500">
          Prices are starting weekday rates, checked {ratesChecked}. We confirm the exact price for
          your dates on WhatsApp.
        </p>
        <MushroomGardenCard />
      </div>
    </section>

    <!-- Ways to stay (use-case pages) -->
    <section
      id="ways-to-stay"
      class="scroll-mt-20 border-b border-stone-100 bg-stone-50 py-16 sm:py-20"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mb-12 text-center">
          <SectionRule center />
          <p class="mb-3 font-sans text-xs tracking-[0.2em] text-stone-500 uppercase">
            Ways to stay
          </p>
          <h2 class="font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            What brings you to Chandigarh?
          </h2>
        </div>
        <!-- Same card language as the collection (design review round 2, item 11): no box, the
             photo carries it. Phones: a swipe row that shows the edge of the next card. -->
        <div class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2 md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0">
          {waysToStay.map((w) => {
            const img = wayPhotos[w.slug] ?? galleries[w.homes[0]][0];
            const names = w.homes
              .map((slug) => properties.find((p) => p.slug === slug)!.name.replace(/^Apricot /, ""))
              .join(" · ");
            return (
              <a
                href={`/ways-to-stay/${w.slug}`}
                class="reveal group flex w-[78%] shrink-0 snap-start flex-col focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 focus-visible:outline-none md:w-auto"
              >
                <div class="aspect-[4/3] overflow-hidden rounded bg-stone-100">
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    widths={[400, 600]}
                    sizes="(min-width: 768px) 33vw, 78vw"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-1.5 pt-4">
                  <h3 class="font-serif text-xl text-stone-900 group-hover:text-apricot">
                    {w.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-stone-600">{w.cardLine}</p>
                  <p class="mt-auto pt-2 text-sm font-medium text-stone-800">{names} &rarr;</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Experiences: the real listings, not a paragraph (design review round 2, item 10). -->
    {experiences.length > 0 && (
      <section
        aria-labelledby="exp-h"
        class="border-b border-stone-100 bg-white py-16 sm:py-20 lg:py-24"
      >
        <div class="mx-auto max-w-7xl px-6 lg:px-12">
          <div class="mb-8 flex items-end justify-between gap-6">
            <div>
              <SectionRule />
              <h2 id="exp-h" class="t-h2">
                Experiences &amp; services
              </h2>
              <p class="mt-2 text-stone-600">
                Arranged by us, from people we know. Book on WhatsApp.
              </p>
            </div>
            <a href="/experiences" class="btn-link shrink-0">
              See all
            </a>
          </div>
          <!-- Phones: a swipe row that shows the edge of the next card. -->
          <ul class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-6 sm:overflow-visible sm:px-0">
            {experiences.slice(0, 3).map((l) => (
              <li class="w-[72%] shrink-0 snap-start sm:w-auto">
                <a href={`/experiences/${l.slug}`} class="group block">
                  <div class="aspect-[4/3] overflow-hidden rounded bg-stone-100">
                    <ExperiencePhoto
                      listing={l}
                      widths={[400, 600, 800]}
                      sizes="(min-width: 640px) 33vw, 72vw"
                      class="transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <p class="mt-3 text-xs font-bold tracking-[0.12em] text-stone-500 uppercase">
                    {l.section}
                  </p>
                  <h3 class="mt-1 font-medium text-stone-900 group-hover:underline">{l.title}</h3>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- More from Apricot: Garden Club and Our Story as two compact tiles instead of two
         full-screen sections (design review round 2, item 09). Phones: a short list. -->
    <section id="story" aria-labelledby="more-h" class="scroll-mt-20 bg-linen py-14 sm:py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <h2 id="more-h" class="t-h2 mb-8">
          More from Apricot
        </h2>
        <ul class="grid gap-5 sm:grid-cols-2 sm:gap-8">
          {more.map((m) => (
            <li>
              <a
                href={m.href}
                target={m.external ? "_blank" : undefined}
                rel={m.external ? "noopener" : undefined}
                class="group flex items-start gap-4 sm:flex-col sm:items-stretch sm:gap-0"
              >
                <div class="aspect-square w-24 shrink-0 overflow-hidden rounded bg-stone-100 sm:aspect-[16/10] sm:w-full">
                  <Picture
                    src={m.photo.src}
                    alt=""
                    widths={[200, 600, 900]}
                    sizes="(min-width: 640px) 45vw, 96px"
                    formats={["avif", "webp"]}
                    fallbackFormat="jpg"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transform-none"
                  />
                </div>
                <div class="sm:mt-4">
                  <h3 class="font-serif text-xl text-stone-900 sm:text-2xl">{m.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-stone-600 sm:text-base">{m.line}</p>
                  <span class="mt-2 inline-block text-sm font-medium text-stone-800 underline underline-offset-4 group-hover:text-apricot">
                    {m.cta}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Thoughtful Amenities -->
    <section
      id="amenities"
      class="scroll-mt-20 border-t border-stone-200/80 bg-stone-50 py-16 sm:py-20 lg:py-24"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div class="mx-auto mb-16 max-w-2xl text-center">
          <SectionRule center />
          <h2 class="mb-4 font-serif text-4xl leading-tight font-normal text-stone-900 sm:text-5xl">
            What every home has
          </h2>
          <p class="font-sans text-base leading-7 font-normal text-stone-600">
            The basics, done properly, so the garden is the only thing on your mind.
          </p>
        </div>
        <ul class="mx-auto grid max-w-5xl grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {amenities.map((a) => (
            <li class="flex gap-4">
              <span class="mt-0.5 shrink-0 text-apricot">
                <Icon name={a.icon} size={22} />
              </span>
              <span>
                <span class="block font-medium text-stone-900">{a.title}</span>
                <span class="mt-1 block text-[15px] leading-6 text-stone-600">{a.text}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Pre-footer CTA -->
    <section class="bg-stone-900 px-6 py-24 text-center text-white">
      <div class="mx-auto max-w-2xl">
        <h2 class="mb-6 font-serif text-4xl leading-tight font-normal sm:text-5xl">
          Ready to unwind?
        </h2>
        <p class="mb-8 text-lg text-stone-300">
          Message us on WhatsApp for availability and the price for your dates.
        </p>
        <a
          href={availability}
          target="_blank"
          rel="noopener"
          class="btn-primary btn-lg focus-visible:ring-offset-stone-900"
        >
          <Icon name="whatsapp" size={20} />
          Check availability
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

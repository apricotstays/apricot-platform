---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { properties } from "@apricot/schema";
import { brand, contact } from "@apricot/brand";

const waHref = contact.whatsappLink(
  "Hi Apricot Stays, I'd like to know about availability.\n\nDates:\nGuests:\nHome (if any):",
);

const orgId = `${brand.url}/#organization`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: brand.name,
      url: `${brand.url}/`,
      logo: `${brand.url}/favicon.svg`,
      slogan: brand.tagline,
      areaServed: { "@type": "Place", name: "Chandigarh Tricity, India" },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "reservations",
        telephone: contact.whatsappE164,
        url: "https://wa.me/919740544873",
      },
    },
    ...properties.map((p) => ({
      "@type": "LodgingBusiness",
      "@id": `${brand.url}/#${p.slug}`,
      name: p.name,
      brand: { "@id": orgId },
      telephone: contact.whatsappE164,
      containedInPlace: { "@type": "Place", name: "Chandigarh Tricity, India" },
    })),
  ],
};
---

<Base
  title="Apricot Stays · Boutique homes in the Chandigarh Tricity"
  description="Apricot Stays is a small collection of boutique homes across the Chandigarh Tricity. Our new website is on its way — chat with us on WhatsApp to book."
  og={{
    title: "Apricot Stays · Stay like you live here",
    description: "Boutique homes across the Chandigarh Tricity. Our new website is on its way.",
  }}
  jsonLd={jsonLd}
>
  <Header />

  <main>
    <div class="wrap hero">
      <section>
        <p class="eyebrow">
          <i></i>New website coming soon
        </p>
        <h1>
          Stay like you <em>live</em> here.
        </h1>
        <p class="lede">
          A small collection of boutique homes across the Chandigarh Tricity, each one kept the way
          we'd keep our own.
        </p>

        <div class="ctas">
          <a class="btn btn-primary" href={waHref} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"></path>
            </svg>
            Chat on WhatsApp
          </a>
        </div>
        <p class="note">
          Or message{" "}
          <a href={waHref} target="_blank" rel="noopener">
            {contact.whatsappDisplay}
          </a>{" "}
          for availability and rates.
        </p>
      </section>

      <aside class="homes" aria-label="Our homes">
        <svg class="art" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="98" fill="#F6E2CF"></circle>
          <circle cx="100" cy="100" r="66" fill="#F1CDAA"></circle>
          <circle cx="100" cy="100" r="34" fill="#E9AE7D"></circle>
        </svg>
        <h2>Our homes</h2>
        <ol>
          {properties.map((p, i) => (
            <li>
              <span class="n" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="name">
                {p.name}
                {p.tag && <span class="tag">{p.tag}</span>}
              </span>
            </li>
          ))}
        </ol>
        <p>
          Photos, details and direct booking are coming to this page soon. Until then, message us
          for availability and rates.
        </p>
      </aside>
    </div>
  </main>

  <Footer />
</Base>

<style is:global>
  body {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 24px 0 56px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--apricot-text);
    margin-bottom: 22px;
  }
  .eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--apricot);
    box-shadow: 0 0 0 0 rgba(227, 135, 75, 0.5);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(227, 135, 75, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(227, 135, 75, 0);
    }
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6.4vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
  }
  h1 em {
    font-style: italic;
    color: var(--apricot-deep);
  }
  .lede {
    font-size: 19px;
    color: var(--ink-2);
    max-width: 34ch;
    margin-bottom: 34px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .btn svg {
    width: 20px;
    height: 20px;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--white);
  }
  .btn-primary:hover {
    background: #4a3527;
    transform: translateY(-1px);
  }
  .note {
    font-size: 14px;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .note a {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .homes {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 34px 32px;
    position: relative;
    overflow: hidden;
  }
  .homes .art {
    position: absolute;
    right: -50px;
    top: -50px;
    width: 230px;
    height: 230px;
    opacity: 0.9;
  }
  .homes h2 {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 22px;
    position: relative;
  }
  .homes ol {
    list-style: none;
    position: relative;
  }
  .homes li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .homes li:last-child {
    padding-bottom: 4px;
  }
  .homes .n {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--apricot-text);
    font-size: 16px;
    width: 24px;
    flex: none;
  }
  .homes .name {
    font-family: var(--font-display);
    font-size: 27px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .homes .tag {
    display: block;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink-2);
    margin-top: 4px;
    letter-spacing: 0;
  }
  .homes p {
    margin-top: 22px;
    font-size: 15px;
    color: var(--ink-2);
    position: relative;
  }

  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    main {
      padding-top: 8px;
    }
  }
  @media (max-width: 480px) {
    .wrap {
      padding: 0 16px;
    }
    .lede {
      font-size: 17px;
    }
    .btn {
      width: 100%;
      justify-content: center;
    }
    .homes {
      padding: 26px 22px;
      border-radius: 22px;
    }
    .homes .name {
      font-size: 23px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyebrow i {
      animation: none;
    }
    .btn {
      transition: none;
    }
  }
</style>

---
/* "Order on WhatsApp" button (design-system .btn-primary, forest variant). `size="lg"` is the full-width button on product pages. */
interface Props {
  href: string;
  label?: string;
  ariaLabel?: string;
  size?: "sm" | "lg";
}
const { href, label = "Order on WhatsApp", ariaLabel, size = "sm" } = Astro.props;
const cls =
  size === "lg" ? "btn-primary btn-forest btn-lg btn-block gap-2.5" : "btn-primary btn-forest px-4";
const icon = size === "lg" ? 18 : 15;
---

<a href={href} target="_blank" rel="noopener" class={cls} aria-label={ariaLabel}>
  <svg
    width={icon}
    height={icon}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"></path>
  </svg>
  {label}
</a>

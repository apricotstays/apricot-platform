---
import { contact, poweredBy } from "@apricot/brand";
import StaizMark from "./StaizMark.astro";
import Icon from "./Icon.astro";
import { properties, shortName } from "@apricot/schema";
import { loadExperiences } from "../experiences/load";

const year = new Date().getFullYear();
// The link appears only once at least one listing has a page (Live, or Draft on previews).
const { listings: experiences } = await loadExperiences();
const wa = contact.whatsappLink("Hi Apricot Stays, I'd like to know about availability.");
const heading = "mb-4 text-xs font-semibold tracking-[0.15em] text-stone-500 uppercase";
const item = "text-sm text-stone-700 transition-colors hover:text-stone-900";
type Link = { label: string; href: string };
const byLength = (links: Link[]) => [...links].sort((x, y) => x.label.length - y.label.length);
const groups = [
  {
    title: "Homes",
    links: byLength(
      properties.map((p) => ({ label: shortName(p.name), href: `/stays/${p.slug}` })),
    ),
  },
  {
    title: "Explore",
    links: byLength([
      { label: "Our story", href: "/our-story" },
      { label: "Ways to stay", href: "/#ways-to-stay" },
      ...(experiences.length > 0 ? [{ label: "Experiences", href: "/experiences" }] : []),
      { label: "The Garden Shop", href: "/shop" },
      { label: "Shoots", href: "/shoots" },
    ]),
  },
  {
    title: "Help",
    links: byLength([
      { label: "Privacy", href: "/privacy" },
      { label: "Policies & FAQ", href: "/policies" },
      { label: contact.whatsappDisplay, href: wa },
      { label: contact.email, href: `mailto:${contact.email}` },
    ]),
  },
];
---

<footer class="bg-stone-50 pt-16 pb-10">
  <div class="container mx-auto px-6">
    <!-- Grouped by intent, shortest link first in each group (design review round 2, item 17). -->
    <div class="mb-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-block text-center" aria-label="Apricot Stays, home">
          <span class="block font-serif text-2xl leading-none text-stone-900">Apricot</span>
          <span class="mt-1 block text-[10px] tracking-[0.35em] text-stone-500">STAYS</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-600">
          Four homes with private gardens at {contact.address.locality}.
        </p>
        <a href={wa} target="_blank" rel="noopener" class="btn-primary mt-5">
          <Icon name="whatsapp" size={16} />
          WhatsApp us
        </a>
      </div>
      {groups.map((g) => (
        <div>
          <p class={heading}>{g.title}</p>
          <ul class="space-y-3">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class={item}
                  target={l.href.startsWith("http") ? "_blank" : undefined}
                  rel={l.href.startsWith("http") ? "noopener" : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-stone-200 pt-8 text-sm text-stone-500 md:flex-row">
      <p>&copy; {year} Apricot Stays</p>
      {poweredBy.url ? (
        <p class="group relative text-xs tracking-[0.15em] uppercase">
          <a
            href={`${poweredBy.url}?${poweredBy.utm}`}
            target="_blank"
            rel="noopener"
            aria-describedby="staiz-hint"
            class="inline-block py-3 decoration-stone-400 underline-offset-4 hover:text-stone-700 hover:underline"
          >
            Powered by <StaizMark />
            <span aria-hidden="true" class="ml-0.5 text-[0.7rem] opacity-60">
              ↗
            </span>
          </a>
          <span
            id="staiz-hint"
            role="tooltip"
            class="pointer-events-none absolute bottom-full left-1/2 z-10 w-max max-w-[15rem] -translate-x-1/2 md:right-0 md:left-auto md:translate-x-0 rounded bg-stone-800 px-3 py-1.5 text-center text-xs tracking-normal text-white normal-case opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100"
          >
            {poweredBy.hint}
          </span>
        </p>
      ) : (
        <p class="text-xs tracking-[0.15em] uppercase">
          Powered by <StaizMark />
        </p>
      )}
    </div>
  </div>
</footer>

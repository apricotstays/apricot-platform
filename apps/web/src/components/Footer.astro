---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <span>© {year} Apricot Stays · Chandigarh Tricity</span>
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 22px 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .wrap {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  @media (max-width: 480px) {
    .wrap {
      padding: 0 16px;
    }
  }
</style>

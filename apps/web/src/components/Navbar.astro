---
import { contact } from "@apricot/brand";
import Icon from "./Icon.astro";

interface Props {
  /** Pin to the top while scrolling (homepage). */
  sticky?: boolean;
}
const { sticky = true } = Astro.props;

/*
 * Header v2 (CK, 19 Nov 2026; modelled on fairly.com): logo left, the two sides of Apricot in
 * the middle, an account menu on the right. Guests come first today; to put owners first later,
 * swap the order of `sides`. Homes, Ways to stay and Our story are reached from the homepage
 * and the footer. Booking starts from each page's own button ("Check dates on WhatsApp").
 */
const appUrl = "https://app.apricotstays.in/";
const manageBooking = contact.whatsappLink(
  "Hi Apricot Stays, I'd like to check or change my booking.\nName: \nDates: ",
);

// build.format "file": "/index.html" → "/", "/list-your-home.html" → "/list-your-home".
const here = Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "$1") || "/";
const ownerSide = here.startsWith("/list-your-home");
const guestSide = !ownerSide && (here === "/" || /^\/(stays|ways-to-stay)\//.test(here));
const sides = [
  { name: "Book a stay", href: "/", active: guestSide },
  { name: "List your home", href: "/list-your-home", active: ownerSide },
];
const tab =
  "inline-flex min-h-11 items-center border-b-2 pt-0.5 text-[15px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 rounded-sm";
const tabOn = "border-apricot font-semibold text-stone-900";
const tabOff = "border-transparent font-medium text-stone-600 hover:text-stone-900";
---

<nav
  class:list={[
    "left-0 right-0 z-50 border-b border-stone-200 bg-white pt-3",
    sticky ? "sticky top-0" : "relative",
  ]}
  aria-label="Main"
>
  <div class="container mx-auto px-6">
    <div class="flex items-center justify-between pb-3 md:grid md:grid-cols-[1fr_auto_1fr]">
      <a
        href="/"
        class="flex flex-col items-center justify-self-start rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4"
        aria-label="Apricot Stays home"
      >
        <span class="font-serif text-xl leading-none font-bold text-stone-800 md:text-2xl">
          Apricot
        </span>
        <span class="mt-1 font-sans text-[0.55rem] font-medium tracking-[0.3em] text-stone-500 uppercase md:text-[0.6rem]">
          Stays
        </span>
      </a>

      <div class="hidden items-center gap-9 md:flex">
        {sides.map((s) => (
          <a
            href={s.href}
            class:list={[tab, s.active ? tabOn : tabOff]}
            aria-current={s.href === here ? "page" : undefined}
          >
            {s.name}
          </a>
        ))}
      </div>

      <!-- Account menu (native disclosure; the script below only closes it on Escape or an outside click). -->
      <details class="account-menu relative justify-self-end" data-account-menu>
        <summary
          class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2.5 rounded-full border border-stone-200 bg-white pr-3 pl-3.5 text-stone-800 transition-colors hover:border-stone-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden"
          aria-label="Account menu"
        >
          <Icon name="menu" size={18} />
          <Icon name="user" size={22} />
        </summary>
        <div class="absolute top-full right-0 z-50 mt-2 flex w-72 flex-col gap-2.5 rounded border border-stone-200 bg-white p-4 shadow-lg">
          <p class="text-center text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">
            Homeowners &amp; caretakers
          </p>
          <a href={appUrl} class="btn-secondary w-full">
            <Icon name="login" size={16} />
            Log in
          </a>
          <a href={appUrl} class="btn-primary btn-forest w-full">
            Sign up
          </a>
          <div class="-mx-4 mt-1.5 border-t border-stone-200"></div>
          <p class="mt-1 text-center text-[11px] font-semibold tracking-[0.2em] text-stone-500 uppercase">
            Staying with us?
          </p>
          <a
            href={manageBooking}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded bg-linen px-6 text-sm font-medium text-forest transition-colors hover:bg-sand focus-visible:ring-2 focus-visible:ring-forest focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            <Icon name="whatsapp" size={15} />
            Manage your booking
          </a>
          <p class="text-center text-xs text-stone-500">
            On WhatsApp. Booked on Airbnb? Manage it there.
          </p>
        </div>
      </details>
    </div>

    <!-- Phone: the two sides as a row under the logo (no menu sheet needed). -->
    <div class="grid grid-cols-2 md:hidden">
      {sides.map((s) => (
        <a
          href={s.href}
          class:list={[tab, "justify-center", s.active ? tabOn : tabOff]}
          aria-current={s.href === here ? "page" : undefined}
        >
          {s.name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Header account menu: close the <details> on Escape or a click outside it.
  // The menu opens and closes without this script (native disclosure); this only tidies it.
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-account-menu]");

  document.addEventListener("click", (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    menus.forEach((m) => {
      if (m.open) {
        m.open = false;
        m.querySelector("summary")?.focus();
      }
    });
  });
</script>

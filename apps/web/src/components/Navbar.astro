---
import { contact } from "@apricot/brand";
import Icon from "./Icon.astro";

interface Props {
  /** Pin to the top while scrolling (homepage). */
  sticky?: boolean;
}
const { sticky = true } = Astro.props;

const bookHref = contact.whatsappLink("Hi Apricot Stays, I'd like to check availability.");
// Ordered by what a guest does first (design audit item 02). The logo is the Home link.
// Experiences and the Garden Shop stay footer-only while they are in soft launch.
const navLinks = [
  { name: "Homes", href: "/#collection" },
  { name: "Ways to stay", href: "/#ways-to-stay" },
  { name: "Our story", href: "/our-story" },
];
const allLinks = navLinks;
const here = Astro.url.pathname.replace(/\.html$/, "");
const current = (href: string) => (href === here ? "page" : undefined);
const link =
  "rounded-sm text-sm font-medium text-stone-600 decoration-apricot decoration-2 underline-offset-8 transition-colors hover:text-apricot focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4 aria-[current=page]:text-stone-900 aria-[current=page]:underline";
---

<nav
  class:list={[
    "left-0 right-0 z-50 border-b border-stone-100 bg-white py-4",
    sticky ? "sticky top-0" : "relative",
  ]}
  aria-label="Main"
>
  <div class="container mx-auto px-6">
    <!-- Desktop -->
    <div class="hidden items-center md:grid md:grid-cols-[1fr_auto_1fr]">
      <a
        href="/"
        class="flex flex-col items-center justify-self-start rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-apricot focus-visible:ring-offset-4"
        aria-label="Apricot Stays home"
      >
        <span class="font-serif text-2xl leading-none font-bold text-stone-800">Apricot</span>
        <span class="mt-1 font-sans text-[0.6rem] font-medium tracking-[0.3em] text-stone-500 uppercase">
          Stays
        </span>
      </a>
      <div class="flex items-center gap-8">
        {navLinks.map((l) => (
          <a href={l.href} class={link} aria-current={current(l.href)}>
            {l.name}
          </a>
        ))}
      </div>
      <a
        href={bookHref}
        target="_blank"
        rel="noopener"
        class="btn-primary justify-self-end px-5"
        aria-label="Check dates on WhatsApp"
        title="Opens WhatsApp with a message ready to send"
      >
        <Icon name="whatsapp" size={16} />
        Check dates
      </a>
    </div>

    <!-- Mobile (no JavaScript: native disclosure for the menu) -->
    <div class="flex items-center justify-between md:hidden">
      <details class="group">
        <summary
          class="cursor-pointer list-none rounded-sm p-2 text-stone-800 [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg
            class="group-open:hidden"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="hidden group-open:block"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <div class="absolute top-full right-0 left-0 flex flex-col gap-2 border-b border-stone-100 bg-white p-6 shadow-sm">
          {allLinks.map((l) => (
            <a
              href={l.href}
              aria-current={current(l.href)}
              class="block rounded-sm py-2 text-lg font-medium text-stone-600 hover:text-apricot"
            >
              {l.name}
            </a>
          ))}
        </div>
      </details>
      <a href="/" class="flex flex-col items-center rounded-sm" aria-label="Apricot Stays home">
        <span class="font-serif text-xl leading-none font-bold text-stone-800">Apricot</span>
        <span class="mt-0.5 font-sans text-[0.5rem] font-medium tracking-[0.25em] text-stone-500 uppercase">
          Stays
        </span>
      </a>
      <a
        href={bookHref}
        target="_blank"
        rel="noopener"
        class="btn-primary h-11 w-11 px-0"
        aria-label="Check dates on WhatsApp"
      >
        <Icon name="whatsapp" size={20} />
      </a>
    </div>
  </div>
</nav>

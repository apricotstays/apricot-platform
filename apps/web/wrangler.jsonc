{
  // Static site served by Cloudflare Workers. Static files are free and unmetered; only /api/*
  // and /mcp run the Worker script (src/worker.ts). ("/mcp" has no static file, so it would reach
  // the Worker anyway; it is listed for clarity.) Secrets (ICAL_<SLUG>, one per home) are set in the
  // Cloudflare dashboard, never in this file.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apricotstays-web",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
  "preview_urls": true,
  "workers_dev": false,
}

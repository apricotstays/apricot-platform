{
  // Static site served by Cloudflare Workers (assets only, no Worker code yet).
  // Free plan: static asset requests are free and unmetered.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "apricotstays-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
  "preview_urls": true,
  "workers_dev": true,
}

{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/dist",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "resource-summary:document:size": [
          "error",
          {
            "maxNumericValue": 51200
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 512000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

{
  "name": "apricot-platform",
  "private": true,
  "description": "Apricot Stays platform monorepo: website, future API, shared brand and schema.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @apricot/web",
    "build": "npm run build -w @apricot/web",
    "preview": "npm run preview -w @apricot/web",
    "check": "npm run check -w @apricot/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links": "linkinator apps/web/dist --recurse --clean-urls --retry --skip \"^https://(www\\\\.)?apricotstays\\\\.in\" --skip \"/experiences$\" --skip \"/shop$\"",
    "a11y": "npx --yes pa11y-ci@5.0.0 --config .pa11yci.json",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "test": "npm run test -w @apricot/web"
  },
  "devDependencies": {
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "wrangler": "4.151.0"
  }
}
